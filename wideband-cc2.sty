\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{wideband-cc2}[2026/09/08 CC column-2 detach-up POC, hardcoded Y (throwaway)]
\RequirePackage{iftex}\RequireLuaTeX

\newcount\wbcc@found  \edef\wbcc@found@n{\the\allocationnumber}
\newcount\wbcc@bid    \edef\wbcc@bid@n{\the\allocationnumber}
\newdimen\wbcc@h      \edef\wbcc@h@n{\the\allocationnumber}
\newdimen\wbcc@topnat \edef\wbcc@topnat@n{\the\allocationnumber}
\newdimen\wbcc@botnat \edef\wbcc@botnat@n{\the\allocationnumber}
\directlua{wbcc = dofile("wideband-cc.lua")}
\directlua{wbcc.setup{found=\wbcc@found@n, bid=\wbcc@bid@n, h=\wbcc@h@n,
                      topnat=\wbcc@topnat@n, botnat=\wbcc@botnat@n}}

\newbox\wbcc@band
\newbox\wbcc@Ltop \newbox\wbcc@Lbot \newbox\wbcc@Rtop \newbox\wbcc@Rbot
\newdimen\wbcc@budget   \wbcc@budget=48\p@   % band budget reserved on the page (hardcoded)
\newdimen\wbcc@detachY  \wbcc@detachY=220\p@ % target Y the band is pulled up to (hardcoded)
\newcount\wbcc@pending  \global\wbcc@pending\z@
\newdimen\wbcc@sep      \wbcc@sep=6\p@

\newcommand\wbccReserve[2]{\global\wbcc@budget=#1\relax \global\wbcc@detachY=#2\relax}

%% POC simplification: foreknowledge of the band, so its height budget is
%% reserved on the page from the start (both columns build to \textheight-budget).
%% The real path discovers the band late and reserves via an in-run rebuild.
\AtBeginDocument{\global\@colht=\dimexpr\@colht-\wbcc@budget\relax}

%% Band authored in column 2: captured OUT of the flow, page marked pending.
\newenvironment{wideband}{%
  \par
  \setbox\wbcc@band\vbox\bgroup
    \hsize\textwidth \columnwidth\textwidth \linewidth\textwidth
}{%
  \egroup
  \global\setbox\wbcc@band\vbox{\hrule\@height\p@ \kern3\p@
     \box\wbcc@band \kern3\p@ \hrule\@height\p@}%
  \global\wbcc@pending\@ne
}

\def\wbcc@vtop#1{\vtop{\kern\z@\unvbox#1}}

\def\@outputdblcol{%
  \if@firstcolumn
    \global\@firstcolumnfalse
    \global\setbox\@leftcolumn\box\@outputbox
  \else
    \global\@firstcolumntrue
    \ifnum\wbcc@pending>\z@
      % pull the band up to the hardcoded Y: split BOTH columns there
      \directlua{wbcc.splitat(\number\@leftcolumn, \number\wbcc@detachY,
                              \number\wbcc@Ltop, \number\wbcc@Lbot)}%
      \directlua{wbcc.splitat(\number\@outputbox, \number\wbcc@detachY,
                              \number\wbcc@Rtop, \number\wbcc@Rbot)}%
      \setbox\@outputbox\vbox to\textheight{%
        \hb@xt@\textwidth{%
          \hb@xt@\columnwidth{\wbcc@vtop\wbcc@Ltop\hss}%
          \hfil{\normalcolor\vrule\@width\columnseprule}\hfil
          \hb@xt@\columnwidth{\wbcc@vtop\wbcc@Rtop\hss}}%
        \vskip\wbcc@sep
        \hb@xt@\textwidth{\box\wbcc@band\hss}%
        \vskip\wbcc@sep
        \hb@xt@\textwidth{%
          \hb@xt@\columnwidth{\wbcc@vtop\wbcc@Lbot\hss}%
          \hfil{\normalcolor\vrule\@width\columnseprule}\hfil
          \hb@xt@\columnwidth{\wbcc@vtop\wbcc@Rbot\hss}}%
        \vfil}%
      \global\wbcc@pending\z@
    \else
      \setbox\@outputbox\vbox{%
        \hb@xt@\textwidth{%
          \hb@xt@\columnwidth{\box\@leftcolumn\hss}%
          \hfil{\normalcolor\vrule\@width\columnseprule}\hfil
          \hb@xt@\columnwidth{\box\@outputbox\hss}}}%
    \fi
    \@combinedblfloats
    \@outputpage
    \global\@colht\textheight
    \begingroup
      \@dblfloatplacement
      \@startdblcolumn
      \@whilesw\if@fcolmade\fi{\@outputpage\@startdblcolumn}%
    \endgroup
  \fi}

\endinput
