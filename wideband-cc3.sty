\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{wideband-cc3}[2026/09/08 CC col-2 detach-up + in-run rebuild POC (throwaway)]
\RequirePackage{iftex}\RequireLuaTeX
\directlua{wbcc = dofile("wideband-cc.lua")}

\newbox\wbcc@band
\newbox\wbcc@Ltop \newbox\wbcc@Lbot \newbox\wbcc@Rtop \newbox\wbcc@Rbot
\newbox\wbcc@galley
\newbox\wbcc@fn
\newdimen\wbcc@budget   \wbcc@budget=48\p@   % band budget (hardcoded)
\newdimen\wbcc@detachY  \wbcc@detachY=220\p@ % target Y (hardcoded)
\newcount\wbcc@pending  \global\wbcc@pending\z@
\newdimen\wbcc@sep      \wbcc@sep=6\p@

\newcommand\wbccReserve[2]{\global\wbcc@budget=#1\relax \global\wbcc@detachY=#2\relax}

%% Band authored in column 2: captured OUT of the flow, page marked pending.
%% NOTE: no budget is reserved up front — the band is discovered late (as it
%% really is), and the room for it is made by an in-run rebuild in the OR.
\newenvironment{wideband}{%
  \par
  \setbox\wbcc@band\vbox\bgroup
    \hsize\textwidth \columnwidth\textwidth \linewidth\textwidth
}{%
  \egroup
  \global\setbox\wbcc@band\vbox{\hrule\@height\p@ \kern3\p@
     \box\wbcc@band \kern3\p@ \hrule\@height\p@}%
  \global\wbcc@pending\@ne
}

\def\wbcc@vtop#1{\vtop{\kern\z@\unvbox#1}}

\def\@outputdblcol{%
  \if@firstcolumn
    \global\@firstcolumnfalse
    \global\setbox\@leftcolumn\box\@outputbox
  \else
    \global\@firstcolumntrue
    \ifnum\wbcc@pending>\z@
      %% ---- in-run rebuild: both columns are full (H); make room for the band
      %% by recombining and re-splitting at the reduced budget H-B; the tail
      %% overflows to the next page. ----
      %% footnotes: pull each finished column's \@makecol footnote block out
      %% (splitting the column would scatter them mid-page) and hold the content;
      %% set one clean block at the true page bottom, and shrink the text budget
      %% by its height so the columns + band + notes fit the page.
      \global\setbox\wbcc@fn\box\voidb@x
      \directlua{wbcc.takefootnotes(\number\@leftcolumn, \number\wbcc@fn)
        wbcc.takefootnotes(\number\@outputbox, \number\wbcc@fn)}%
      \@tempdimc\z@
      \ifvoid\wbcc@fn\else
        \@tempdimc\dimexpr\skip\footins + \ht\wbcc@fn + \dp\wbcc@fn + 4\p@\relax
      \fi
      \dimen@\dimexpr\textheight-\wbcc@budget-\@tempdimc\relax   % H - band - notes
      %% Recombine the two finished columns into one galley. A plain
      %% \unvbox\@leftcolumn\unvbox\@outputbox would leave column 1's \@makecol
      %% bottom tail (\vskip-\dp + an infinite-stretch \@textbottom) butted
      %% against column 2's leading \topskip at the join, which reads ~2pt tight
      %% mid-column. joincols drops both and splices the baselineskip TeX would
      %% have put there (needs the depth/height, hence Lua).
      \@tempdima\baselineskip \@tempdimb\lineskip
      \directlua{wbcc.joincols(\number\wbcc@galley, \number\@leftcolumn,
        \number\@outputbox, \number\@tempdima, \number\@tempdimb, \number\lineskiplimit)}%
      \splittopskip\z@skip \splitmaxdepth\maxdimen \vbadness\maxdimen \vfuzz\maxdimen
      \setbox\wbcc@Ltop\vsplit\wbcc@galley to\wbcc@detachY
      \setbox\wbcc@Lbot\vsplit\wbcc@galley to\dimexpr\dimen@-\wbcc@detachY\relax
      \setbox\wbcc@Rtop\vsplit\wbcc@galley to\wbcc@detachY
      \setbox\wbcc@Rbot\vsplit\wbcc@galley to\dimexpr\dimen@-\wbcc@detachY\relax
      %% \wbcc@galley now holds the overflow (~2B) for the next page
      \setbox\@outputbox\vbox to\textheight{%
        \hb@xt@\textwidth{%
          \hb@xt@\columnwidth{\wbcc@vtop\wbcc@Ltop\hss}%
          \hfil{\normalcolor\vrule\@width\columnseprule}\hfil
          \hb@xt@\columnwidth{\wbcc@vtop\wbcc@Rtop\hss}}%
        \vskip\wbcc@sep
        \hb@xt@\textwidth{\box\wbcc@band\hss}%
        \vskip\wbcc@sep
        \hb@xt@\textwidth{%
          \hb@xt@\columnwidth{\wbcc@vtop\wbcc@Lbot\hss}%
          \hfil{\normalcolor\vrule\@width\columnseprule}\hfil
          \hb@xt@\columnwidth{\wbcc@vtop\wbcc@Rbot\hss}}%
        \vfil
        \ifvoid\wbcc@fn\else
          \vskip\skip\footins \footnoterule \unvbox\wbcc@fn
        \fi}%
      \global\wbcc@pending\z@
      \@combinedblfloats
      \@outputpage
      \global\@colht\textheight
      %% Re-inject the overflow so it becomes the next page. \@outputbox (column
      %% 2) was built by \@makecol, so its tail is the column-bottom glue: a
      %% \vskip of -\dp (depth compensation) followed by \@textbottom, an
      %% infinite-stretch fill (\raggedbottom). \unvbox\@outputbox carried that
      %% tail into the galley, and it rides the overflow's bottom. Left in place
      %% it lands mid-column on the next page and shares that column's slack, so
      %% a paragraph split by the break rejoins with a stretched (loose) gap.
      %% Dropping it (pure TeX, on the list \unvbox just laid down) heals the
      %% seam; the held material keeps its own break glue on the contribution
      %% list. NB: no \pagediscards — it is empty here (\savingvdiscards is 0),
      %% and once integration sets \savingvdiscards=1 it would hold column 2's
      %% *top* discards, i.e. the wrong glue at this seam.
      \unvbox\wbcc@galley           % overflow becomes the next page
      \unskip\unpenalty\unskip      % drop \@makecol's column-bottom glue
    \else
      \setbox\@outputbox\vbox{%
        \hb@xt@\textwidth{%
          \hb@xt@\columnwidth{\box\@leftcolumn\hss}%
          \hfil{\normalcolor\vrule\@width\columnseprule}\hfil
          \hb@xt@\columnwidth{\box\@outputbox\hss}}}%
      \@combinedblfloats
      \@outputpage
      \global\@colht\textheight
    \fi
    \begingroup
      \@dblfloatplacement
      \@startdblcolumn
      \@whilesw\if@fcolmade\fi{\@outputpage\@startdblcolumn}%
    \endgroup
  \fi}

\endinput
