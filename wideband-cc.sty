\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{wideband-cc}[2026/09/09 Continuous-Column wide-band POC (throwaway)]
%% Continuous-Column (CC) full-width equation bands in two-column mode.
%%
%% A band declared mid-column is captured out of the flow. On the page it lands
%% on, the output routine recombines BOTH finished \@makecol columns into one
%% galley, re-splits it at a reduced budget, and re-assembles the page as
%%   row, band, row, band, ..., row   (interleaved segments and full-width bands)
%% with the overflow \unvboxed onto the next page. This runs on the normal
%% \@outputdblcol — no custom \output penalty — so column 1 and column 2 bands
%% are handled by the same code (a band on either column reaches the same rebuild
%% once both columns are finished). Footnotes and [b] bottom floats baked into
%% the finished columns are pulled out and re-set once at the true page bottom.
%%
%% Node surgery (joincols / takefootnotes / takebotfloats) lives in
%% wideband-cc.lua. See POC-NOTES-CC.md for the mechanism and honest limits.
%%
%% \wbccReserve{<Y>} sets the document default split height Y for bands that do not
%% give their own [<Y>]. Omitting \wbccReserve entirely leaves Y automatic (derived
%% from each band's marker; see \wbcc@detachY and \wbcc@autoY). The per-page text
%% budget is computed in the output routine from \@colht and the band heights.
%%
%% NOTE: throwaway POC on the cc/poc branch. The earlier per-rung POCs (col-1
%% marker CC; col-2 foreknowledge detach-up) are superseded by this single
%% in-run rebuild and preserved only in git history.
\RequirePackage{iftex}\RequireLuaTeX
\directlua{wbcc = dofile("wideband-cc.lua")}

\newbox\wbcc@band                          % scratch capture box
\newbox\wbcc@galley
\newbox\wbcc@fn
\newbox\wbcc@bfL \newbox\wbcc@bfR
\newdimen\wbcc@bfh \newdimen\@tempdimd
\newdimen\wbcc@detachY  \wbcc@detachY=\maxdimen% AUTO sentinel: derive Y from the marker
\newdimen\wbcc@sep      \wbcc@sep=6\p@
\newdimen\wbcc@bud                          % per-column text budget on a band page
\newdimen\wbcc@ymax                         % lowest a band may be auto-placed (Phase B clamp)
\newdimen\wbcc@prevY
\newcount\wbcc@np       \global\wbcc@np\z@   % bands captured but not yet placed (all pages)
\newcount\wbcc@overdue  \global\wbcc@overdue\z@% front prefix of the pool forced onto THIS page
\newcount\wbcc@found \edef\wbcc@found@n{\the\allocationnumber}% count-register index for Lua
\newcount\wbcc@ride  \edef\wbcc@ride@n{\the\allocationnumber}% markers riding in the overflow
\newcount\wbcc@nb       \global\wbcc@nb\z@   % bands PLACED on the current page (overdue + fit)
\newcount\wbcc@m                             % new markers that fit this page (descent result)
\newcount\wbcc@i \newcount\wbcc@j            % \wbcc@j: inner counter for the band sort
\newif\ifwbcc@more                           % descent loop continuation flag
\chardef\wbcc@MAX=4                          % up to 4 bands / 5 segments per page

%% Pools: band boxes + split heights, and the L/R column-segment boxes.
\wbcc@i=\@ne
\loop
  \expandafter\newbox\csname wbcc@b@\the\wbcc@i\endcsname
  \expandafter\newdimen\csname wbcc@Yd@\the\wbcc@i\endcsname
  \expandafter\newbox\csname wbcc@L@\the\wbcc@i\endcsname
  \expandafter\newbox\csname wbcc@R@\the\wbcc@i\endcsname
  \advance\wbcc@i\@ne
\ifnum\wbcc@i<\numexpr\wbcc@MAX+\tw@\relax \repeat  % one extra segment box (N+1)

%% Marker-height pool \wbcc@mh@1..MAX: each band marker's galley position, filled by
%% wbcc.markpos. Allocated in a dedicated loop so the registers are CONTIGUOUS (Lua
%% writes base, base+1, ...); \wbcc@mh@base is \wbcc@mh@1's register index.
\expandafter\newdimen\csname wbcc@mh@1\endcsname
\edef\wbcc@mh@base{\the\allocationnumber}%
\wbcc@i=\tw@
\loop
  \expandafter\newdimen\csname wbcc@mh@\the\wbcc@i\endcsname
  \advance\wbcc@i\@ne
\ifnum\wbcc@i<\numexpr\wbcc@MAX+\@ne\relax \repeat

\newcommand\wbccReserve[1]{\global\wbcc@detachY=#1\relax}

%% Each band is captured OUT of the flow and pushed onto the page's band list with
%% its own split height Y (optional arg, default \wbcc@detachY). Y is the amount of
%% column text placed above the band, i.e. its galley-split position.
%% Frame the captured band (a rule above and below) into box register #1.
\def\wbcc@frame#1{\global\setbox#1\vbox{\hrule\@height\p@ \kern3\p@
     \box\wbcc@band \kern3\p@ \hrule\@height\p@}}
%% Typeset the captured band in the flow, as a full-width display: the one-column
%% fallback (there a "band" is just a display), and the never-lose-content fallback
%% when the pending pool is full.
\def\wbcc@inline{\wbcc@frame\@tempboxa \par\vskip\wbcc@sep \box\@tempboxa \vskip\wbcc@sep}

\newenvironment{wideband}[1][\wbcc@detachY]{%
  \def\wbcc@curY{#1}%              % capture Y here — #1 is not visible in \end
  \par
  \setbox\wbcc@band\vbox\bgroup
    \hsize\textwidth \columnwidth\textwidth \linewidth\textwidth
}{%
  \egroup
  \if@twocolumn
    \ifnum\wbcc@np<\numexpr\wbcc@MAX+\@ne\relax   % pool holds MAX+1 (placement caps at MAX/page)
      \global\advance\wbcc@np\@ne
      \expandafter\wbcc@frame\csname wbcc@b@\the\wbcc@np\endcsname
      \global\csname wbcc@Yd@\the\wbcc@np\endcsname=\wbcc@curY\relax
      \directlua{wbcc.mark()}%   % leave a marker at the authored position (page assignment)
    \else
      \PackageError{wideband-cc}{too many bands waiting for placement (\the\wbcc@np\space
        already pending)}{At most \the\wbcc@MAX\space bands are placed per page and a band
        waits until the text it follows ships. Move this band further into the text.
        It is typeset in the flow here so that nothing is lost.}%
      \wbcc@inline
    \fi
  \else
    \wbcc@inline                   % one column: no output routine of ours runs
  \fi
}

%% A band deferred on the document's last page (its marker sat past the band page's
%% budget) has no next page to land on: give it one instead of losing it. Then any band
%% still pending never had its marker seen at a column's top level (e.g. authored inside
%% a box) — say so rather than drop it silently.
\AtEndDocument{%
  \clearpage
  \ifnum\wbcc@overdue>\z@ \null\clearpage \fi
  \ifnum\wbcc@np>\z@
    \PackageWarningNoLine{wideband-cc}{\the\wbcc@np\space band(s) were captured but never
      placed: their markers never reached a column's top level (a band inside a box or
      list cannot be placed)}%
  \fi}

%% A height-0 \vtop around box #1 (the leading \kern makes the height 0 so all of #1
%% is depth; see \wbcc@assemble for why). #1 is \box'ed, NOT \unvbox'ed, so a segment
%% keeps the exact height \wbcc@fitseg gave it.
\def\wbcc@vtop#1{\vtop{\kern\z@\box#1}}

%% Finish one column segment #1 (a box register) that \wbcc@splitcol just produced
%% with \vsplit ... to X. \vsplit packages the segment EXACTLY to X, but TeX may have
%% reached X by SHRINKING glue (\medskip has minus 2pt), and the old \unvbox in the row
%% dropped that glue-set, letting the row re-expand to its natural height — past X and
%% past the budget (measured +6.56pt on one row; only at split points where the best
%% break needed shrink, hence the "resonance"). So:
%%   - natural size > the set size (vsplit shrank): keep the box as set — the same
%%     thing stock \flushbottom does at a column bottom;
%%   - otherwise, under \flushbottom (\@textbottom is \relax): fill the row exactly to X
%%     the way \@makecol finishes a column (\unvbox, back up the last depth), so the
%%     glue stretches and both columns end level at the band;
%%   - otherwise (\raggedbottom): rebox to the NATURAL height (<= X), so glue stays
%%     natural and the band follows the taller column's last line, not a fixed Y.
%% In every branch the box is no taller than X + \maxdepth-clamped depth, so the rows
%% sum to at most \wbcc@bud + (N+1)\maxdepth and \wbcc@computebud's reserve bounds the
%% page: no split height can overflow it. \boxmaxdepth\maxdepth mirrors \vsplit's
%% \splitmaxdepth so a deep last line moves into the height, never past the reserve.
\def\wbcc@fitseg#1{%
  \setbox\@tempboxa\vbox{\boxmaxdepth\maxdepth\unvcopy#1}%   natural size of the content
  \ifdim\dimexpr\ht\@tempboxa+\dp\@tempboxa\relax>\dimexpr\ht#1+\dp#1\relax
  \else
    \ifx\@textbottom\relax
      \dimen@\dp\@tempboxa
      \setbox#1\vbox to\ht#1{\unvbox#1\vskip-\dimen@}%
    \else
      \setbox#1\box\@tempboxa
    \fi
  \fi}

%% Sort the pending bands ascending by split height Y (bubble sort; N<=4). Bands are
%% captured in source order but may be authored with out-of-order Y; the segment split
%% below assumes ascending Y (segment i = Y_i - Y_{i-1} >= 0). Swap the band box and its
%% Y together.
\def\wbcc@sortbands{%
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\wbcc@nb\do{%
    \wbcc@j\@ne
    \@whilenum\wbcc@j<\numexpr\wbcc@nb-\wbcc@i+\@ne\relax\do{%
      \@tempdima\csname wbcc@Yd@\the\wbcc@j\endcsname
      \ifdim\@tempdima=\maxdimen \PackageError{wideband-cc}{auto Y unresolved for a
        placed band}{\string\wbcc@autoY\space must run before \string\wbcc@sortbands}\fi
      \edef\wbcc@next{\the\numexpr\wbcc@j+\@ne\relax}%
      \@tempdimb\csname wbcc@Yd@\wbcc@next\endcsname
      \ifdim\@tempdima>\@tempdimb
        \setbox\@tempboxa\box\csname wbcc@b@\the\wbcc@j\endcsname
        \global\setbox\csname wbcc@b@\the\wbcc@j\endcsname\box\csname wbcc@b@\wbcc@next\endcsname
        \global\setbox\csname wbcc@b@\wbcc@next\endcsname\box\@tempboxa
        \csname wbcc@Yd@\the\wbcc@j\endcsname\@tempdimb
        \csname wbcc@Yd@\wbcc@next\endcsname\@tempdima
      \fi
      \advance\wbcc@j\@ne}%
    \advance\wbcc@i\@ne}%
}

%% Split one recombined column (already in \wbcc@galley) into up to \wbcc@nb+1 segments:
%% segment i (i=1..nb) is the text row ABOVE band i, height Y_i - (last real split). If
%% that gap is below one \baselineskip — two bands at equal or near-equal Y — no text
%% fits between them, so the row is voided (segment i empty) and the bands stack; the
%% split point does NOT advance, so band i+1 measures its gap from the same point. This
%% keeps a degenerate \vsplit to ~0pt (which still takes a whole line) from overflowing
%% the page. #1 is L or R; run \wbcc@sortbands first.
\def\wbcc@splitcol#1{%
  \wbcc@prevY\z@
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@nb+\@ne\relax\do{%
    \@tempdima\dimexpr\csname wbcc@Yd@\the\wbcc@i\endcsname-\wbcc@prevY\relax
    \ifdim\@tempdima<\baselineskip
      \setbox\csname wbcc@#1@\the\wbcc@i\endcsname\box\voidb@x   % stacked band: no text row
    \else
      \setbox\csname wbcc@#1@\the\wbcc@i\endcsname\vsplit\wbcc@galley to\@tempdima
      \expandafter\wbcc@fitseg\csname wbcc@#1@\the\wbcc@i\endcsname
      \wbcc@prevY\csname wbcc@Yd@\the\wbcc@i\endcsname
    \fi
    \advance\wbcc@i\@ne}%
  \setbox\csname wbcc@#1@\the\wbcc@i\endcsname
    \vsplit\wbcc@galley to\dimexpr\wbcc@bud-\wbcc@prevY\relax
  \expandafter\wbcc@fitseg\csname wbcc@#1@\the\wbcc@i\endcsname
}

%% One two-column row from segment #1.
\def\wbcc@row#1{%
  \hb@xt@\textwidth{%
    \hb@xt@\columnwidth{\wbcc@vtop{\csname wbcc@L@#1\endcsname}\hss}%
    \hfil{\normalcolor\vrule\@width\columnseprule}\hfil
    \hb@xt@\columnwidth{\wbcc@vtop{\csname wbcc@R@#1\endcsname}\hss}}%
}

%% Interleave segments and bands: row1, band1, row2, band2, ..., row(nb+1).
%% A band box has depth 0 and a \wbcc@row is a height-0 \vtop, so TeX would insert a
%% full \baselineskip of interline glue before each post-band row — unbudgeted height
%% that pushes the page past \@colht. \nointerlineskip after each band suppresses just
%% that glue (the explicit \vskip\wbcc@sep still spaces the band from the row).
\def\wbcc@assemble{%
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@nb+\@ne\relax\do{%
    \ifvoid\csname wbcc@L@\the\wbcc@i\endcsname
    \else                                    % stacked band (voided segment): no row
      \wbcc@row{\the\wbcc@i}%
      \vskip\wbcc@sep
    \fi
    \hb@xt@\textwidth{\box\csname wbcc@b@\the\wbcc@i\endcsname\hss}%
    \vskip\wbcc@sep
    \nointerlineskip
    \advance\wbcc@i\@ne}%
  \wbcc@row{\the\wbcc@i}%
}

%% Per-column text budget for placing \wbcc@nb bands: \@colht minus the band heights
%% (+gaps), minus footnotes (\@tempdimc) and bottom floats (\wbcc@bfh), minus a
%% per-row depth/interline reserve. Use \@colht (NOT \textheight): on a page carrying
%% a \dbltop float the columns were built at the reduced \@colht and \@combinedblfloats
%% adds the float back to reach \textheight, so budgeting on \textheight would
%% double-count. Each of the N+1 rows can carry up to \maxdepth of last-line depth, so
%% reserve (N+1)*\maxdepth; the band sits a \lineskip below each row, so reserve
%% N*\lineskip too. The caller sets \@tempdimc/\wbcc@bfh first (0 during the fit
%% descent, real values for the actual split).
\def\wbcc@computebud{%
  \@tempdima\z@
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@nb+\@ne\relax\do{%
    \advance\@tempdima\dimexpr\ht\csname wbcc@b@\the\wbcc@i\endcsname
      +\dp\csname wbcc@b@\the\wbcc@i\endcsname+\tw@\wbcc@sep\relax
    \advance\wbcc@i\@ne}%
  \wbcc@i\numexpr\wbcc@nb+\@ne\relax
  \@tempdimd\maxdepth \multiply\@tempdimd\wbcc@i         % (N+1)*\maxdepth: row last-line depths
  \@tempdimb\lineskip \multiply\@tempdimb\wbcc@nb        % N*\lineskip: row->band interline glue
  \advance\@tempdimd\@tempdimb
  \wbcc@bud\dimexpr\@colht-\@tempdima-\@tempdimc-\wbcc@bfh-\@tempdimd\relax
}

%% Automatic split height Y for each placed band whose \wbcc@Yd@i is still the AUTO
%% sentinel (\maxdimen). Y = the marker's height WITHIN its own rebuilt column, so the
%% band appears where it was authored:
%%   - a NEW band (pool position i > \wbcc@overdue) reads its marker's galley position
%%     P = \wbcc@mh@(i-\wbcc@overdue). The rebuilt page is [col1|col2] cut at \wbcc@bud,
%%     so a marker with P<=\wbcc@bud sits in the left column (Y=P) and one with P>\wbcc@bud
%%     in the right column (Y=P-\wbcc@bud, the detach-up placement). \wbcc@bud IS the L/R
%%     boundary because \wbcc@splitcol's L segments sum to exactly \wbcc@bud.
%%   - an OVERDUE band (pool position i <= \wbcc@overdue) was deferred from an earlier page
%%     and has NO marker here (they were stripped), so it lands at the top (Ymin).
%% Clamp to [Ymin, \wbcc@ymax]: Ymin = one \baselineskip (never flush to the header);
%% \wbcc@ymax = \wbcc@bud - (tallest placed band) - gaps - \baselineskip guarantees the
%% band plus one line below still fit. Clamping is monotone so it cannot reorder bands;
%% near-equal clamped Y's are de-collided by \wbcc@sortbands + the \wbcc@splitcol stack.
%% MUST run AFTER \wbcc@computebud (needs \wbcc@bud) and BEFORE \wbcc@sortbands (the marker
%% index i-\wbcc@overdue tracks the UNSORTED pool order, which the sort permutes). The N>1
%% clamp is deliberately simple (one page-wide \wbcc@ymax from the tallest band); see
%% docs/design-auto-y-source.md.
\def\wbcc@autoY{%
  \@tempdima\z@                                   % tallest placed band (ht+dp)
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@nb+\@ne\relax\do{%
    \@tempdimb\dimexpr\ht\csname wbcc@b@\the\wbcc@i\endcsname
      +\dp\csname wbcc@b@\the\wbcc@i\endcsname\relax
    \ifdim\@tempdimb>\@tempdima \@tempdima\@tempdimb \fi
    \advance\wbcc@i\@ne}%
  \wbcc@ymax\dimexpr\wbcc@bud-\@tempdima-\tw@\wbcc@sep-\baselineskip\relax
  \ifdim\wbcc@ymax<\z@ \wbcc@ymax\z@ \fi                      % degenerate page: no inverted range
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@nb+\@ne\relax\do{%
    \@tempdimb\csname wbcc@Yd@\the\wbcc@i\endcsname
    \ifdim\@tempdimb=\maxdimen                     % auto sentinel -> derive from marker
      \ifnum\wbcc@i>\wbcc@overdue
        \edef\wbcc@mk{\the\numexpr\wbcc@i-\wbcc@overdue\relax}%   marker index (unsorted order)
        \@tempdimb\csname wbcc@mh@\wbcc@mk\endcsname             % galley position P
        \ifdim\@tempdimb>\wbcc@bud \advance\@tempdimb-\wbcc@bud \fi  % right column: P-\wbcc@bud
      \else
        \@tempdimb\z@                              % overdue band: its text ended on the
      \fi                                          % previous page -> the very top, Y=0
      \wbcc@clampY
    \else                                          % explicit [Y] / \wbccReserve: same
      \dimen@\@tempdimb                            % clamp, but say so — the author asked
      \wbcc@clampY                                 % for a Y the page cannot honour
      \ifdim\dimen@=\@tempdimb\else
        \PackageWarning{wideband-cc}{split height \the\dimen@\space leaves no room for the
          band and a line below it on this page; clamped to \the\@tempdimb}%
      \fi
    \fi
    \csname wbcc@Yd@\the\wbcc@i\endcsname\@tempdimb
    \advance\wbcc@i\@ne}%
}
%% Clamp \@tempdimb into [0, \wbcc@ymax]. Ymin is 0, not a line: a marker sits between
%% paragraphs, so if any text precedes it on the page P is already >= one line, and a
%% band at Y=0 (P=0, or an overdue band) belongs at the very top — a positive Ymin
%% would only orphan one line of the NEXT paragraph above it. \wbcc@splitcol voids a
%% row shorter than a line, so Y=0 simply means "band first". \wbcc@ymax leaves the
%% band plus one line below it.
\def\wbcc@clampY{%
  \ifdim\@tempdimb<\z@ \@tempdimb\z@ \fi
  \ifdim\@tempdimb>\wbcc@ymax \@tempdimb\wbcc@ymax \fi}

%% Budget heights of the extracted footnote block (\wbcc@fn -> \@tempdimc: \skip\footins
%% + block + \footnoterule slack) and bottom floats (\wbcc@bfL/R -> \wbcc@bfh: the
%% taller side + \textfloatsep). Used twice per band page: once on the measurement
%% copies before the fit descent, once after the real extraction.
\def\wbcc@bottomdims{%
  \@tempdimc\z@
  \ifvoid\wbcc@fn\else
    \@tempdimc\dimexpr\skip\footins + \ht\wbcc@fn + \dp\wbcc@fn + 4\p@\relax
  \fi
  \wbcc@bfh\z@
  \ifvoid\wbcc@bfL\else \wbcc@bfh\dimexpr\ht\wbcc@bfL+\dp\wbcc@bfL\relax \fi
  \ifvoid\wbcc@bfR\else
    \@tempdimd\dimexpr\ht\wbcc@bfR+\dp\wbcc@bfR\relax
    \ifdim\@tempdimd>\wbcc@bfh \wbcc@bfh\@tempdimd \fi
  \fi
  \ifdim\wbcc@bfh>\z@ \advance\wbcc@bfh\textfloatsep \fi}

%% How many bands to place on this page. The overdue prefix (bands deferred from an
%% earlier page) is always placed; the descent decides how many of THIS page's new
%% markers also fit. Bands are laid on the recombined galley [col1|col2], so a marker
%% at galley position P lands on this page iff P <= 2*\wbcc@bud (a col-1 marker below
%% \wbcc@bud simply becomes the top of the rebuilt right column — still on the page).
%% Galley order is document order, so the deepest fitting marker is the last one;
%% shrink \wbcc@m (fitting new markers) until marker \wbcc@m fits, then \wbcc@nb =
%% overdue + \wbcc@m. The caller has already set \@tempdimc / \wbcc@bfh to this page's
%% footnote and bottom-float heights (measured on COPIES of the columns, see
%% wbcc.measurebottom), so the descent uses the same budget the real split will: a
%% band whose text would be pushed off a page that also carries notes or floats is
%% deferred together with its text, never placed a page ahead of it.
\def\wbcc@duecount{%
  \wbcc@m\wbcc@found
  \loop
    \wbcc@nb\numexpr\wbcc@overdue+\wbcc@m\relax
    \wbcc@morefalse
    \ifnum\wbcc@nb>\wbcc@MAX                 % at most MAX bands (MAX+1 rows) per page:
      \ifnum\wbcc@m>\z@                      % shed this page's new markers first ...
        \advance\wbcc@m\m@ne \wbcc@moretrue
      \else                                  % ... then place MAX of the overdue ones;
        \wbcc@nb\wbcc@MAX                    % the rest stay overdue for the next page
      \fi
    \else
      \ifnum\wbcc@m>\z@
        \wbcc@computebud
        \@tempdima\csname wbcc@mh@\the\wbcc@m\endcsname
        \@tempdimb\tw@\wbcc@bud
        \ifdim\@tempdima>\@tempdimb \advance\wbcc@m\m@ne \wbcc@moretrue \fi
      \fi
    \fi
  \ifwbcc@more\repeat
}

%% After placing \wbcc@nb bands (pool prefix 1..\wbcc@nb), drop them and slide the
%% still-pending tail (\wbcc@nb+1 .. \wbcc@np) down to the front, boxes and Y's
%% together, then shrink the pending total.
\def\wbcc@shiftpool{%
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@np-\wbcc@nb+\@ne\relax\do{%
    \edef\wbcc@src{\the\numexpr\wbcc@i+\wbcc@nb\relax}%
    \global\setbox\csname wbcc@b@\the\wbcc@i\endcsname\box\csname wbcc@b@\wbcc@src\endcsname
    \global\csname wbcc@Yd@\the\wbcc@i\endcsname\csname wbcc@Yd@\wbcc@src\endcsname
    \advance\wbcc@i\@ne}%
  \global\advance\wbcc@np-\wbcc@nb
}

\def\@outputdblcol{%
  \if@firstcolumn
    \global\@firstcolumnfalse
    \global\setbox\@leftcolumn\box\@outputbox
  \else
    \global\@firstcolumntrue
    %% Page assignment (marker-driven): scan both finished columns non-destructively.
    %% \wbcc@found = this page's markers; their galley positions land in \wbcc@mh@1..
    %% A band is placed on the page its authored marker falls on — not the page where
    %% \begin{wideband} happened to be read.
    \directlua{wbcc.markpos(\number\@leftcolumn, \number\@outputbox,
      \wbcc@found@n, \wbcc@mh@base)}%
    \wbcc@j\numexpr\wbcc@np-\wbcc@overdue\relax     % pending bands still carrying a marker
    \ifnum\wbcc@found>\wbcc@j
      \PackageWarning{wideband-cc}{markpos found \the\wbcc@found\space markers but
        \the\wbcc@j\space marked bands pending; clamping}%
      \global\wbcc@found\wbcc@j
    \fi
    %% Budget this page's footnotes and bottom floats BEFORE deciding what fits: run the
    %% real extraction on copies of the columns, read the hold boxes, void them again.
    %% Only when a band is pending — an ordinary page is not even copied.
    \@tempdimc\z@ \wbcc@bfh\z@
    \ifnum\wbcc@np>\z@
      \global\setbox\wbcc@fn\box\voidb@x
      \global\setbox\wbcc@bfL\box\voidb@x \global\setbox\wbcc@bfR\box\voidb@x
      \directlua{wbcc.measurebottom(\number\@leftcolumn, \number\@outputbox,
        \number\wbcc@galley, \number\wbcc@fn, \number\wbcc@bfL, \number\wbcc@bfR)}%
      \wbcc@bottomdims
      \global\setbox\wbcc@fn\box\voidb@x
      \global\setbox\wbcc@bfL\box\voidb@x \global\setbox\wbcc@bfR\box\voidb@x
    \fi
    \wbcc@duecount        % -> \wbcc@m fitting new markers; \wbcc@nb = \wbcc@overdue + \wbcc@m
    \ifnum\wbcc@nb>\z@
      %% strip only the markers of the bands PLACED here (the first \wbcc@m found — the
      %% descent sheds from the last). A deferred-new marker past the band-page budget
      %% lies in the OVERFLOW and rides to the next page, where it is found again at its
      %% true position, so its band lands after its text and not at the page top. A
      %% deferred-new marker that turns out to lie inside this page's rows ships with
      %% them (a zero-size whatsit); its band becomes overdue below.
      \directlua{wbcc.stripmarks(\number\@leftcolumn, \number\@outputbox, \number\wbcc@m)}%
      %% ---- in-run rebuild placing \wbcc@nb bands (overdue + newly-fitting) ----
      %% footnotes: pull each finished column's \@makecol footnote block out and
      %% hold it; one clean block goes at the true page bottom.
      \global\setbox\wbcc@fn\box\voidb@x
      \directlua{wbcc.takefootnotes(\number\@leftcolumn, \number\wbcc@fn)
        wbcc.takefootnotes(\number\@outputbox, \number\wbcc@fn)}%
      %% bottom floats: \@makecol put each column's [b] floats at its bottom; the
      %% reduced budget would carry them into the overflow (they would defer). Pull
      %% them out per column and re-set them at the band page's bottom; shrink the
      %% budget by the taller side + \textfloatsep so text + band + floats + notes fit.
      \global\setbox\wbcc@bfL\box\voidb@x \global\setbox\wbcc@bfR\box\voidb@x
      \directlua{wbcc.takebotfloats(\number\@leftcolumn, \number\wbcc@bfL)
        wbcc.takebotfloats(\number\@outputbox, \number\wbcc@bfR)}%
      \wbcc@bottomdims      % \@tempdimc (notes) and \wbcc@bfh (floats) — the same values
                            % the fit descent already used, now from the real extraction
      %% Order matters: budget first (auto-Y's clamp needs \wbcc@bud), then resolve any
      %% auto (\maxdimen) split heights from the marker positions, THEN sort. \wbcc@autoY
      %% keys markers to UNSORTED pool positions, so it MUST run before \wbcc@sortbands.
      \wbcc@computebud      % real per-column budget (footnote/float heights now known)
      \wbcc@autoY           % auto Y = marker's within-column height, clamped (Phase B)
      %% sort the placed bands by Y so the segment split sees ascending split heights;
      %% near-equal Y's then stack (see \wbcc@splitcol) instead of forcing a ~0pt segment.
      \ifnum\wbcc@nb>\@ne \wbcc@sortbands \fi
      %% recombine both finished columns (seam-correct join), then split per band.
      \@tempdima\baselineskip \@tempdimb\lineskip
      \directlua{wbcc.joincols(\number\wbcc@galley, \number\@leftcolumn,
        \number\@outputbox, \number\@tempdima, \number\@tempdimb, \number\lineskiplimit)}%
      %% \splitmaxdepth\maxdepth bounds each segment's last-line depth (matching the
      %% (N+1)*\maxdepth budget reserve above). \vbadness is silenced (the trailing
      %% \vfil makes every band page technically underfull, and a \flushbottom row
      %% filled to its split height may be underfull too). \vfuzz stays at TeX's
      %% default 0.1pt: every row is exactly its split height or shorter (see
      %% \wbcc@fitseg), the budget is exact sp arithmetic, and the footnote/float
      %% blocks are budgeted with their own slack, so any Overfull \vbox on a band
      %% page is a genuine defect (content past the text area). Tests assert none.
      %% (It used to be 2pt, which silently absorbed the shrink re-expansion that
      %% \wbcc@fitseg now removes.)
      %% \splittopskip\topskip: every segment after the first is the head of a
      %% remainder, so \vsplit gives it \splittopskip glue. With \z@skip its first line
      %% sat flush at its own height (~7pt) while the left column's top row keeps the
      %% page's \topskip (10pt): the right column's first baseline was 3.1pt higher than
      %% the left's on every band page, and rows after a band could misalign by their
      %% first lines' height difference. \topskip puts every segment's first baseline
      %% where a stock column puts it. Budget-neutral: the glue is inside the segment.
      \splittopskip\topskip \splitmaxdepth\maxdepth \vbadness\maxdimen \vfuzz.1\p@
      \wbcc@splitcol L
      \wbcc@splitcol R
      %% \wbcc@galley now holds the overflow for the next page; count the deferred-new
      %% markers that ride in it (their bands stay pending WITH a marker, not overdue).
      \directlua{wbcc.countmarks(\number\wbcc@galley, \wbcc@ride@n)}%
      \setbox\@outputbox\vbox to\@colht{%
        \wbcc@assemble
        \vfil
        \ifdim\wbcc@bfh>\z@
          \vskip\textfloatsep
          \hb@xt@\textwidth{%
            \hb@xt@\columnwidth{\ifvoid\wbcc@bfL\else\wbcc@vtop\wbcc@bfL\fi\hss}%
            \hfil
            \hb@xt@\columnwidth{\ifvoid\wbcc@bfR\else\wbcc@vtop\wbcc@bfR\fi\hss}}%
        \fi
        \ifvoid\wbcc@fn\else
          \vskip\skip\footins \footnoterule \unvbox\wbcc@fn
        \fi}%
      %% pool bookkeeping: the placed prefix is 1..\wbcc@nb = (\wbcc@nb-\wbcc@m) overdue
      %% bands + \wbcc@m new ones. Still overdue for the next page: the overdue bands
      %% not placed (the per-page cap) plus this page's deferred-new markers that shipped
      %% inside its rows (\wbcc@found-\wbcc@m-\wbcc@ride; the \wbcc@ride riding ones keep
      %% their marker and are not overdue) — together
      %% \wbcc@overdue-\wbcc@nb+\wbcc@found-\wbcc@ride. Galley order = source order, so
      %% the shipped ones precede the riding ones in the pool and the overdue prefix stays
      %% contiguous. Drop the placed prefix and slide the pending tail down to the front.
      \global\wbcc@overdue\numexpr\wbcc@overdue-\wbcc@nb+\wbcc@found-\wbcc@ride\relax
      \wbcc@shiftpool
      \global\wbcc@nb\z@
      \@combinedblfloats
      \@outputpage
      \global\@colht\textheight
      \unvbox\wbcc@galley           % overflow becomes the next page
      \unskip\unpenalty\unskip      % drop \@makecol's column-bottom glue
      \penalty\outputpenalty        % re-assert the break that fired us, so the overflow
                                    % ships even when it is the document's last content:
                                    % on a \clearpage-forced flush (\outputpenalty=-\@Mi)
                                    % this re-forces a page for the trailing galley; on a
                                    % natural page break it is inert and later content
                                    % fills the next page as before (plain-TeX idiom).
                                    % ONLY the rebuild branch re-inserts: the stock \else
                                    % branch ships a whole page and must NOT add this, or
                                    % the second (overflow) firing would re-force again and
                                    % emit a blank page. Do not "symmetrise" the two.
    \else
      %% nothing to place this page (no overdue band, and no new marker fit): the two
      %% finished columns ship as a normal two-column page, so every marker found here
      %% ships with it — strip them and defer their bands to the next page as overdue.
      %% A pending band with no marker here is left untouched — it is placed on the page
      %% its marker lands on.
      \directlua{wbcc.stripmarks(\number\@leftcolumn, \number\@outputbox, \number\wbcc@found)}%
      \global\wbcc@overdue\wbcc@found
      \setbox\@outputbox\vbox{%
        \hb@xt@\textwidth{%
          \hb@xt@\columnwidth{\box\@leftcolumn\hss}%
          \hfil{\normalcolor\vrule\@width\columnseprule}\hfil
          \hb@xt@\columnwidth{\box\@outputbox\hss}}}%
      \@combinedblfloats
      \@outputpage
      \global\@colht\textheight
    \fi
    \begingroup
      \@dblfloatplacement
      \@startdblcolumn
      \@whilesw\if@fcolmade\fi{\@outputpage\@startdblcolumn}%
    \endgroup
  \fi}

\endinput
