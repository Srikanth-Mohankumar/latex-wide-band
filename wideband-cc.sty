\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{wideband-cc}[2026/09/09 Continuous-Column wide-band POC (throwaway)]
%% Continuous-Column (CC) full-width equation bands in two-column mode.
%%
%% A band declared mid-column is captured out of the flow. On the page it lands
%% on, the output routine recombines BOTH finished \@makecol columns into one
%% galley, re-splits it at a reduced budget, and re-assembles the page as
%%   row, band, row, band, ..., row   (interleaved segments and full-width bands)
%% with the overflow \unvboxed onto the next page. This runs on the normal
%% \@outputdblcol — no custom \output penalty — so column 1 and column 2 bands
%% are handled by the same code (a band on either column reaches the same rebuild
%% once both columns are finished). Footnotes and [b] bottom floats baked into
%% the finished columns are pulled out and re-set once at the true page bottom.
%%
%% Node surgery (joincols / takefootnotes / takebotfloats) lives in
%% wideband-cc.lua. See POC-NOTES-CC.md for the mechanism and honest limits.
%%
%% \wbccReserve{<budget>}{<Y>} sets the default split height Y. NOTE: the first
%% argument (<budget>, \wbcc@budget) is currently UNUSED — the per-page text
%% budget is computed in the output routine from \textheight and the band
%% heights, not from this value. It is kept only so existing tests need not
%% change; a follow-up should drop it to \wbccReserve{<Y>}.
%%
%% NOTE: throwaway POC on the cc/poc branch. The earlier per-rung POCs (col-1
%% marker CC; col-2 foreknowledge detach-up) are superseded by this single
%% in-run rebuild and preserved only in git history.
\RequirePackage{iftex}\RequireLuaTeX
\directlua{wbcc = dofile("wideband-cc.lua")}

\newbox\wbcc@band                          % scratch capture box
\newbox\wbcc@galley
\newbox\wbcc@fn
\newbox\wbcc@bfL \newbox\wbcc@bfR
\newdimen\wbcc@bfh \newdimen\@tempdimd
\newdimen\wbcc@budget   \wbcc@budget=48\p@  % legacy \wbccReserve #1 — unused (see header)
\newdimen\wbcc@detachY  \wbcc@detachY=220\p@% default split height Y
\newdimen\wbcc@sep      \wbcc@sep=6\p@
\newdimen\wbcc@bud                          % per-column text budget on a band page
\newdimen\wbcc@prevY
\newcount\wbcc@pending  \global\wbcc@pending\z@
\newcount\wbcc@nb       \global\wbcc@nb\z@   % bands pending on the current page
\newcount\wbcc@i
\chardef\wbcc@MAX=4                          % up to 4 bands / 5 segments per page

%% Pools: band boxes + split heights, and the L/R column-segment boxes.
\wbcc@i=\@ne
\loop
  \expandafter\newbox\csname wbcc@b@\the\wbcc@i\endcsname
  \expandafter\newdimen\csname wbcc@Yd@\the\wbcc@i\endcsname
  \expandafter\newbox\csname wbcc@L@\the\wbcc@i\endcsname
  \expandafter\newbox\csname wbcc@R@\the\wbcc@i\endcsname
  \advance\wbcc@i\@ne
\ifnum\wbcc@i<\numexpr\wbcc@MAX+\tw@\relax \repeat  % one extra segment box (N+1)

\newcommand\wbccReserve[2]{\global\wbcc@budget=#1\relax \global\wbcc@detachY=#2\relax}

%% Each band is captured OUT of the flow and pushed onto the page's band list with
%% its own split height Y (optional arg, default \wbcc@detachY). Y is the amount of
%% column text placed above the band, i.e. its galley-split position.
\newenvironment{wideband}[1][\wbcc@detachY]{%
  \def\wbcc@curY{#1}%              % capture Y here — #1 is not visible in \end
  \par
  \setbox\wbcc@band\vbox\bgroup
    \hsize\textwidth \columnwidth\textwidth \linewidth\textwidth
}{%
  \egroup
  \global\advance\wbcc@nb\@ne
  \global\setbox\csname wbcc@b@\the\wbcc@nb\endcsname\vbox{\hrule\@height\p@ \kern3\p@
     \box\wbcc@band \kern3\p@ \hrule\@height\p@}%
  \global\csname wbcc@Yd@\the\wbcc@nb\endcsname=\wbcc@curY\relax
  \global\wbcc@pending\@ne
}

\def\wbcc@vtop#1{\vtop{\kern\z@\unvbox#1}}

%% Split one recombined column (already in \wbcc@galley) into \wbcc@nb+1 segments:
%% segment i (i=1..nb) has height Y_i - Y_{i-1}; the last has \wbcc@bud - Y_nb.
%% #1 is L or R.
\def\wbcc@splitcol#1{%
  \wbcc@prevY\z@
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@nb+\@ne\relax\do{%
    \setbox\csname wbcc@#1@\the\wbcc@i\endcsname
      \vsplit\wbcc@galley to\dimexpr\csname wbcc@Yd@\the\wbcc@i\endcsname-\wbcc@prevY\relax
    \wbcc@prevY\csname wbcc@Yd@\the\wbcc@i\endcsname
    \advance\wbcc@i\@ne}%
  \setbox\csname wbcc@#1@\the\wbcc@i\endcsname
    \vsplit\wbcc@galley to\dimexpr\wbcc@bud-\wbcc@prevY\relax
}

%% One two-column row from segment #1.
\def\wbcc@row#1{%
  \hb@xt@\textwidth{%
    \hb@xt@\columnwidth{\wbcc@vtop{\csname wbcc@L@#1\endcsname}\hss}%
    \hfil{\normalcolor\vrule\@width\columnseprule}\hfil
    \hb@xt@\columnwidth{\wbcc@vtop{\csname wbcc@R@#1\endcsname}\hss}}%
}

%% Interleave segments and bands: row1, band1, row2, band2, ..., row(nb+1).
\def\wbcc@assemble{%
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@nb+\@ne\relax\do{%
    \wbcc@row{\the\wbcc@i}%
    \vskip\wbcc@sep
    \hb@xt@\textwidth{\box\csname wbcc@b@\the\wbcc@i\endcsname\hss}%
    \vskip\wbcc@sep
    \advance\wbcc@i\@ne}%
  \wbcc@row{\the\wbcc@i}%
}

\def\@outputdblcol{%
  \if@firstcolumn
    \global\@firstcolumnfalse
    \global\setbox\@leftcolumn\box\@outputbox
  \else
    \global\@firstcolumntrue
    \ifnum\wbcc@pending>\z@
      %% ---- in-run rebuild with N bands ----
      %% footnotes: pull each finished column's \@makecol footnote block out and
      %% hold it; one clean block goes at the true page bottom.
      \global\setbox\wbcc@fn\box\voidb@x
      \directlua{wbcc.takefootnotes(\number\@leftcolumn, \number\wbcc@fn)
        wbcc.takefootnotes(\number\@outputbox, \number\wbcc@fn)}%
      \@tempdimc\z@
      \ifvoid\wbcc@fn\else
        \@tempdimc\dimexpr\skip\footins + \ht\wbcc@fn + \dp\wbcc@fn + 4\p@\relax
      \fi
      %% bottom floats: \@makecol put each column's [b] floats at its bottom; the
      %% reduced budget would carry them into the overflow (they would defer). Pull
      %% them out per column and re-set them at the band page's bottom; shrink the
      %% budget by the taller side + \textfloatsep so text + band + floats + notes fit.
      \global\setbox\wbcc@bfL\box\voidb@x \global\setbox\wbcc@bfR\box\voidb@x
      \directlua{wbcc.takebotfloats(\number\@leftcolumn, \number\wbcc@bfL)
        wbcc.takebotfloats(\number\@outputbox, \number\wbcc@bfR)}%
      \wbcc@bfh\z@
      \ifvoid\wbcc@bfL\else \wbcc@bfh\dimexpr\ht\wbcc@bfL+\dp\wbcc@bfL\relax \fi
      \ifvoid\wbcc@bfR\else
        \@tempdimd\dimexpr\ht\wbcc@bfR+\dp\wbcc@bfR\relax
        \ifdim\@tempdimd>\wbcc@bfh \wbcc@bfh\@tempdimd \fi
      \fi
      \ifdim\wbcc@bfh>\z@ \advance\wbcc@bfh\textfloatsep \fi
      %% per-column text budget = \textheight - (sum of band heights + gaps) - notes
      \@tempdima\z@
      \wbcc@i\@ne
      \@whilenum\wbcc@i<\numexpr\wbcc@nb+\@ne\relax\do{%
        \advance\@tempdima\dimexpr\ht\csname wbcc@b@\the\wbcc@i\endcsname
          +\dp\csname wbcc@b@\the\wbcc@i\endcsname+\tw@\wbcc@sep\relax
        \advance\wbcc@i\@ne}%
      \wbcc@bud\dimexpr\textheight-\@tempdima-\@tempdimc-\wbcc@bfh\relax
      %% recombine both finished columns (seam-correct join), then split per band.
      \@tempdima\baselineskip \@tempdimb\lineskip
      \directlua{wbcc.joincols(\number\wbcc@galley, \number\@leftcolumn,
        \number\@outputbox, \number\@tempdima, \number\@tempdimb, \number\lineskiplimit)}%
      \splittopskip\z@skip \splitmaxdepth\maxdimen \vbadness\maxdimen \vfuzz\maxdimen
      \wbcc@splitcol L
      \wbcc@splitcol R
      %% \wbcc@galley now holds the overflow for the next page
      \setbox\@outputbox\vbox to\textheight{%
        \wbcc@assemble
        \vfil
        \ifdim\wbcc@bfh>\z@
          \vskip\textfloatsep
          \hb@xt@\textwidth{%
            \hb@xt@\columnwidth{\ifvoid\wbcc@bfL\else\wbcc@vtop\wbcc@bfL\fi\hss}%
            \hfil
            \hb@xt@\columnwidth{\ifvoid\wbcc@bfR\else\wbcc@vtop\wbcc@bfR\fi\hss}}%
        \fi
        \ifvoid\wbcc@fn\else
          \vskip\skip\footins \footnoterule \unvbox\wbcc@fn
        \fi}%
      \global\wbcc@pending\z@
      \global\wbcc@nb\z@
      \@combinedblfloats
      \@outputpage
      \global\@colht\textheight
      \unvbox\wbcc@galley           % overflow becomes the next page
      \unskip\unpenalty\unskip      % drop \@makecol's column-bottom glue
    \else
      \setbox\@outputbox\vbox{%
        \hb@xt@\textwidth{%
          \hb@xt@\columnwidth{\box\@leftcolumn\hss}%
          \hfil{\normalcolor\vrule\@width\columnseprule}\hfil
          \hb@xt@\columnwidth{\box\@outputbox\hss}}}%
      \@combinedblfloats
      \@outputpage
      \global\@colht\textheight
    \fi
    \begingroup
      \@dblfloatplacement
      \@startdblcolumn
      \@whilesw\if@fcolmade\fi{\@outputpage\@startdblcolumn}%
    \endgroup
  \fi}

\endinput
