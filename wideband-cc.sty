\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{wideband-cc}[2026/10/21 v0.10 Continuous-Column wide-band release candidate]
%% Continuous-Column (CC) full-width equation bands in two-column mode.
%%
%% A band declared mid-column is captured out of the flow. On the page it lands
%% on, the output routine recombines BOTH finished \@makecol columns into one
%% galley, re-splits it at a reduced budget, and re-assembles the page as
%%   row, band, row, band, ..., row   (interleaved segments and full-width bands)
%% with the overflow \unvboxed onto the next page. This runs on the normal
%% \@outputdblcol — no custom \output penalty — so column 1 and column 2 bands
%% are handled by the same code (a band on either column reaches the same rebuild
%% once both columns are finished). Footnotes and [b] bottom floats baked into
%% the finished columns are pulled out and re-set once at the true page bottom.
%%
%% Node surgery (joincols / takefootnotes / takebotfloats) lives in
%% wideband-cc.lua. See POC-NOTES-CC.md for the mechanism and honest limits.
%%
%% \wbccReserve{<Y>} sets the document default split height Y for bands that do not
%% give their own [<Y>]. Omitting \wbccReserve entirely leaves Y automatic (derived
%% from each band's marker; see \wbcc@detachY and \wbcc@autoY). The per-page text
%% budget is computed in the output routine from \@colht and the band heights.
%%
%% Spacing (\setlength; each band records the values current at its \end{wideband}):
%%   \wbccskipabove  6pt   text -> band                \wbccskipbelow  6pt  band -> text
%%   \wbccframesep   3pt   padding cue rule -> content \wbccrulewidth  .4pt cue rule thickness
%%   \wbccruletick   0pt   RevTeX-style tick at a cue rule's inner end (6pt for RevTeX's look)
%% \wbccrulesleft / \wbccrulesright {revtex|mirror|none}, \wbccrulestyle{column|revtex|
%% mirror|none}, \renewcommand\wbccrulefraction{.5}: the reading-order cue rules'
%% arrangement per reading column and their length (see "READING-ORDER CUE RULES").
%% \renewcommand\wbccfullpagefraction{.75}: a band this tall (fraction of \textheight)
%% gets a page of its own instead of text flowed around it.
%%
%% This release-candidate implementation supersedes the earlier per-rung POCs
%% (column-1 marker CC and column-2 foreknowledge detach-up), which remain in
%% git history as design evidence.
\RequirePackage{iftex}\RequireLuaTeX
\RequirePackage{keyval}
%% Adapters. `auto' (the default) and `generic' run the same-page engine: a band is
%% placed on the page it is written on, mid-column, by rebuilding the finished
%% columns. That is the manual-placement mode (mr-bean on Elsevier NeoPage): one
%% compile, no .aux state; the operator puts a band where there is room, and when
%% it cannot be placed there the package says so with a LaTeX error (see
%% "OPERATOR ERRORS") so the pagination can be adjusted.
%% `elsevier' forces the page-top placement instead: the band ends the current page
%% and opens LaTeX's full-width top area on the next one, without rebuilding the
%% host's columns. It keeps source order with no operator, at the cost of a short
%% page before each band.
\newif\ifwbcc@elsevieradapter
\def\wbcc@adapterrequest{auto}
\DeclareOption{auto}{\def\wbcc@adapterrequest{auto}}
\DeclareOption{generic}{\def\wbcc@adapterrequest{generic}}
\DeclareOption{elsevier}{\def\wbcc@adapterrequest{elsevier}}
\DeclareOption*{\PackageError{wideband-cc}{Unknown option `\CurrentOption'}{Valid
  options are auto, generic and elsevier. A mistyped adapter must not silently
  fall back to `auto'.}}
\ProcessOptions\relax
\def\wbcc@adapter@elsevier{elsevier}
\ifx\wbcc@adapterrequest\wbcc@adapter@elsevier \wbcc@elsevieradaptertrue \fi
%% Use kpathsea rather than the process working directory.  A package installed
%% in a TEXMF tree is normally loaded from a document directory that does not
%% contain wideband-cc.lua; plain dofile("wideband-cc.lua") fails there.
%% A host that loads the .sty by path (\usepackage{/some/dir/wideband-cc}, as NeoPage
%% does with its \Templatepath prefix, with no TEXINPUTS) is invisible to kpathsea, so
%% the directory of the .sty being read (status.filename) is tried next.
\directlua{
  local wbccfile = kpse.find_file("wideband-cc.lua")
  if not wbccfile then
    local sty = status.filename or ""
    local dir = sty:match("^(.*)[/\\]")
    if dir then
      local beside = dir .. "/wideband-cc.lua"
      local fh = io.open(beside, "r")
      if fh then fh:close() wbccfile = beside end
    end
  end
  if not wbccfile then
    tex.error("wideband-cc.lua not found",
      {"Install wideband-cc.lua beside wideband-cc.sty in a searchable TEXMF tree."})
  else
    wbcc = dofile(wbccfile)
  end
}
%% Without the Lua companion nothing below can work: stop loading here rather than
%% fail later with Lua errors on every band and every page.
\ifnum\directlua{tex.sprint(wbcc and 1 or 0)}=\z@ \endinput \fi

\newbox\wbcc@band                          % scratch capture box
\newbox\wbcc@hostband                      % host-adapter output box
\newbox\wbcc@galley
\newbox\wbcc@fn
\newbox\wbcc@bfL \newbox\wbcc@bfR
\newbox\wbcc@top \newbox\wbcc@bot            % band page: rows+bands above the last row / bottom block
\newbox\wbcc@tpL \newbox\wbcc@tpR            % band page: each column's top area (host figures, top floats)
\newdimen\wbcc@bfh \newdimen\@tempdimd
\newdimen\wbcc@detachY  \wbcc@detachY=\maxdimen% AUTO sentinel: derive Y from the marker
%% User spacing controls (\setlength). Recorded PER BAND when \end{wideband} is reached,
%% so a \setlength before one \begin{wideband} affects that band only (a value set inside
%% the environment body is local to the band's box and has no effect).
\newdimen\wbccskipabove  \wbccskipabove=6\p@  % text -> band frame (above the band)
\newdimen\wbccskipbelow  \wbccskipbelow=6\p@  % band frame -> text (below the band)
\newdimen\wbccframesep   \wbccframesep=3\p@   % padding between the rules and the content
\newdimen\wbccrulewidth  \wbccrulewidth=.4\p@ % thickness of the cue rules (RevTeX's 0.4pt)
\newdimen\wbcc@bud                          % per-column text budget on a band page
\newdimen\wbcc@ymax                         % lowest a band may be auto-placed (Phase B clamp)
\newdimen\wbcc@prevY
\newdimen\wbcc@used \newdimen\wbcc@gstart \newdimen\wbcc@rL  % \wbcc@splitcol: consumed, start, left residual
\newdimen\wbcc@lastcut                       % attempt loop: shorten the last row by this much
\newdimen\wbcc@total                         % measured height of the page's stack
\newbox\wbcc@gcopy                           % the joined galley, kept for a re-split
\newcount\wbcc@tries                         % attempt loop bound
\newif\ifwbcc@row                            % assemble/measure: this row has a text segment
\newcount\wbcc@np       \global\wbcc@np\z@   % bands captured but not yet placed (all pages)
\newcount\wbcc@overdue  \global\wbcc@overdue\z@% front prefix of the pool forced onto THIS page
\newcount\wbcc@found \edef\wbcc@found@n{\the\allocationnumber}% count-register index for Lua
\newdimen\wbcc@enl \edef\wbcc@enl@n{\the\allocationnumber}% this page's \enlargethispage
\newdimen\wbcc@toph \edef\wbcc@toph@n{\the\allocationnumber}% the columns' top areas (taller)
\newcount\wbcc@ride  \edef\wbcc@ride@n{\the\allocationnumber}% markers riding in the overflow
\newcount\wbcc@fnmoved \edef\wbcc@fnmoved@n{\the\allocationnumber}% notes moved to the overflow
\newcount\wbcc@nb       \global\wbcc@nb\z@   % bands PLACED on the current page (overdue + fit)
\newcount\wbcc@m                             % new markers that fit this page (descent result)
\newcount\wbcc@i \newcount\wbcc@j            % \wbcc@j: inner counter for the band sort
\newcount\wbcc@cap                           % this page's placement cap (see \wbcc@duecount)
\newcount\wbcc@serial \global\wbcc@serial\z@ % bands captured so far: "band #n" in log lines
\newif\ifwbcc@more                           % descent loop continuation flag
\newif\ifwbcc@fit                            % descent: every candidate has room below its Y
\chardef\wbcc@MAX=4                          % up to 4 bands / 5 segments per page

%% Pools: band boxes + split heights, and the L/R column-segment boxes.
\wbcc@i=\@ne
\loop
  \expandafter\newbox\csname wbcc@b@\the\wbcc@i\endcsname
  \expandafter\newdimen\csname wbcc@Yd@\the\wbcc@i\endcsname
  \expandafter\newdimen\csname wbcc@ab@\the\wbcc@i\endcsname   % this band's skip above
  \expandafter\newdimen\csname wbcc@bl@\the\wbcc@i\endcsname   % ... and below
  \expandafter\newbox\csname wbcc@L@\the\wbcc@i\endcsname
  \expandafter\newbox\csname wbcc@R@\the\wbcc@i\endcsname
  \advance\wbcc@i\@ne
\ifnum\wbcc@i<\numexpr\wbcc@MAX+\tw@\relax \repeat  % one extra segment box (N+1)

%% Marker-height pool \wbcc@mh@1..MAX: each band marker's galley position, filled by
%% wbcc.markpos. Allocated in a dedicated loop so the registers are CONTIGUOUS (Lua
%% writes base, base+1, ...); \wbcc@mh@base is \wbcc@mh@1's register index.
\expandafter\newdimen\csname wbcc@mh@1\endcsname
\edef\wbcc@mh@base{\the\allocationnumber}%
\wbcc@i=\tw@
\loop
  \expandafter\newdimen\csname wbcc@mh@\the\wbcc@i\endcsname
  \advance\wbcc@i\@ne
\ifnum\wbcc@i<\numexpr\wbcc@MAX+\@ne\relax \repeat

\newcommand\wbccReserve[1]{\global\wbcc@detachY=#1\relax}

%% Each band is captured OUT of the flow and pushed onto the page's band list with
%% its own split height Y (optional arg, default \wbcc@detachY). Y is the amount of
%% column text placed above the band, i.e. its galley-split position.
%% Box the captured band into register #1 with \wbccframesep of padding above and below
%% (the padding between the reading-order cue rules and the content; the rules themselves
%% are added at assembly, when the band's column is known — see \wbcc@cue).
\def\wbcc@frame#1{\global\setbox#1\vbox{\kern\wbccframesep \box\wbcc@band \kern\wbccframesep}}

%% READING-ORDER CUE RULES (RevTeX widetext geometry): one half-width rule ABOVE the band
%% on one side and one BELOW it on the other side, each \wbccrulefraction of \textwidth
%% long (0.5), \wbccrulewidth thick, plain (\wbccruletick = 0pt; RevTeX's 6pt end tick is
%% available). The two arrangements:
%%   revtex   above LEFT,  below RIGHT     mirror   above RIGHT, below LEFT
%% Which one a band gets follows its READING column (the column its marker sits in — the
%% other column runs straight past the band), so a left band and a right band come out
%% opposite. Defaults: a band read in the LEFT column gets `mirror` (the rule above sits
%% over the right column, whose reader must skip the band), a band read in the RIGHT
%% column gets `revtex`. Everything is a setting:
%%   \wbccrulesleft{revtex|mirror|none}    arrangement for bands read in the left column
%%   \wbccrulesright{revtex|mirror|none}   ... in the right column
%%   \wbccrulestyle{column}                use those (default)
%%   \wbccrulestyle{revtex|mirror|none}    one fixed arrangement for every band
%%   \begin{wideband}[rules=revtex|mirror|column|none]   this band only
%% A band at the top of a page (both columns read it first) and a full-page band get no
%% rules from these automatic arrangements. There is no full-width frame.
%% EXPLICIT arrangements, for a band the operator places by hand (mr-bean), drawn exactly
%% as asked, a page-top band included (a proof's style: a band at the top of the page with
%% one rule under it, a band at the bottom with one rule over it, both on the same half):
%%   same        above RIGHT and below RIGHT      same-left    both on the LEFT half
%%   above       one rule above, RIGHT half       above-left   ... LEFT half
%%   below       one rule below, RIGHT half       below-left   ... LEFT half
%% y=top and y=bottom place a band at the top of its page (Y=0) and as low as the page
%% allows (Y=\wbcc@ymax, no clamp error); with rules=below / rules=above they give the
%% page-top and page-bottom bands of that style.
\newcommand\wbccrulefraction{.5}
\newdimen\wbccruletick \wbccruletick=\z@
\newcommand\wbccrulestyle[1]{\def\wbcc@rulestyle{#1}}
\newcommand\wbccrulesleft[1]{\def\wbcc@rulesL{#1}}
\newcommand\wbccrulesright[1]{\def\wbcc@rulesR{#1}}
\wbccrulestyle{column}\wbccrulesleft{mirror}\wbccrulesright{revtex}
%% Resolve style #1 (revtex|mirror|column|none) for a band read in column #2 (L|R|T) into
%% \wbcc@above / \wbcc@below (L|R|N: the half the rule occupies, N = no rule).
\def\wbcc@rulesides#1#2{%
  \def\wbcc@above{N}\def\wbcc@below{N}%
  \def\wbcc@tmp{#1}\def\wbcc@tmpb{column}%
  \ifx\wbcc@tmp\wbcc@tmpb \if R#2\let\wbcc@tmp\wbcc@rulesR\else\let\wbcc@tmp\wbcc@rulesL\fi\fi
  %% The automatic arrangements draw nothing on a page-top band (both columns read it
  %% first); the explicit ones below are drawn wherever the band is.
  \if T#2\else
    \def\wbcc@tmpb{revtex}\ifx\wbcc@tmp\wbcc@tmpb \def\wbcc@above{L}\def\wbcc@below{R}\fi
    \def\wbcc@tmpb{mirror}\ifx\wbcc@tmp\wbcc@tmpb \def\wbcc@above{R}\def\wbcc@below{L}\fi
  \fi
  \def\wbcc@tmpb{same}\ifx\wbcc@tmp\wbcc@tmpb \def\wbcc@above{R}\def\wbcc@below{R}\fi
  \def\wbcc@tmpb{same-left}\ifx\wbcc@tmp\wbcc@tmpb \def\wbcc@above{L}\def\wbcc@below{L}\fi
  \def\wbcc@tmpb{above}\ifx\wbcc@tmp\wbcc@tmpb \def\wbcc@above{R}\fi
  \def\wbcc@tmpb{above-left}\ifx\wbcc@tmp\wbcc@tmpb \def\wbcc@above{L}\fi
  \def\wbcc@tmpb{below}\ifx\wbcc@tmp\wbcc@tmpb \def\wbcc@below{R}\fi
  \def\wbcc@tmpb{below-left}\ifx\wbcc@tmp\wbcc@tmpb \def\wbcc@below{L}\fi}
%% The two rule boxes (full-width hboxes). The tick sits at the rule's inner end: up on
%% the rule above the band, down on the rule below it.
%% Every \vrule gets BOTH \@height and \@depth: a dimension left out "runs" to the
%% enclosing hbox's, so the half rule would inherit the 6pt tick depth and be drawn as a
%% 6pt bar (it was).
\def\wbcc@rulehalf{\vrule\@height\wbccrulewidth\@depth\z@\@width\wbccrulefraction\textwidth}
\def\wbcc@tickup{\vrule\@height\wbccruletick\@depth\z@\@width\wbccrulewidth}
\def\wbcc@tickdown{\vrule\@height\wbccrulewidth\@depth\wbccruletick\@width\wbccrulewidth}
\def\wbcc@cueabove#1{%
  \if L#1\hb@xt@\textwidth{\wbcc@rulehalf\wbcc@tickup\hfil}\fi
  \if R#1\hb@xt@\textwidth{\hfil\wbcc@tickup\wbcc@rulehalf}\fi}
\def\wbcc@cuebelow#1{%
  \if L#1\hb@xt@\textwidth{\wbcc@rulehalf\wbcc@tickdown\hfil}\fi
  \if R#1\hb@xt@\textwidth{\hfil\wbcc@tickdown\wbcc@rulehalf}\fi}

%% FULL-PAGE bands. A band that would take most of a page is not flowed around: it
%% gets a page of its own (like a float page), unframed, after the page that carries
%% the text it follows. \ifwbcc@fp <- the band in \wbcc@band is full-page when its
%% height (plus the gaps) reaches \wbccfullpagefraction of \textheight, or when what
%% would remain for text on a fresh page is less than two lines (then flowing is
%% pointless and the last row could not hold a line).
\newcommand\wbccfullpagefraction{.75}
\newif\ifwbcc@fp
\newif\ifwbcc@fpforce                          % [fullpage] option: own page regardless of size
\def\wbcc@fptest{%
  \wbcc@fpfalse
  \ifwbcc@fpforce \wbcc@fptrue \fi
  \@tempdima\dimexpr\ht\wbcc@band+\dp\wbcc@band+\wbccskipabove+\wbccskipbelow\relax
  \ifdim\@tempdima>\wbccfullpagefraction\textheight \wbcc@fptrue \fi
  \ifdim\dimexpr\textheight-\@tempdima-\tw@\maxdepth-\lineskip\relax<\tw@\baselineskip
    \wbcc@fptrue \fi}
%% Store the captured band as pool entry #2 (box register #1): framed for an in-flow
%% band, raw for a full-page one; record which in \wbcc@fp@<#2>.
\def\wbcc@capture#1#2{%
  \global\advance\wbcc@serial\@ne
  \expandafter\xdef\csname wbcc@id@#2\endcsname{\the\wbcc@serial}%
  \expandafter\xdef\csname wbcc@ln@#2\endcsname{\the\inputlineno}%
  \global\csname wbcc@ab@#2\endcsname\wbccskipabove
  \global\csname wbcc@bl@#2\endcsname\wbccskipbelow
  \expandafter\global\expandafter\let\csname wbcc@rs@#2\endcsname\wbcc@rulestyle
  \wbcc@fptest
  \ifwbcc@fp
    \global\setbox#1\box\wbcc@band
    \expandafter\gdef\csname wbcc@fp@#2\endcsname{1}%
  \else
    \wbcc@frame#1%
    \expandafter\gdef\csname wbcc@fp@#2\endcsname{0}%
  \fi}
%% Typeset the captured band in the flow, as a full-width display: the one-column
%% fallback (there a "band" is just a display), and the never-lose-content fallback
%% when the pending pool is full. A full-page-sized band goes in unframed.
\def\wbcc@inline{%
  \wbcc@fptest
  \ifwbcc@fp \global\setbox\@tempboxa\box\wbcc@band \else \wbcc@frame\@tempboxa \fi
  \par\vskip\wbccskipabove \box\@tempboxa \directlua{wbcc.putinserts()}\vskip\wbccskipbelow}

%% Elsevier / NeoPage adapter.  The host's output routine carries spacereserve,
%% float-gate and last-page-balancing state that the generic node rebuild cannot
%% reproduce.  Flush everything authored before the band, then use the kernel's
%% supported full-width top area.  This is intentionally a safe page-top
%% degradation: it gives up same-page mid-column placement rather than reorder
%% article material or corrupt the host's sidecars.  A forced/full-page-sized
%% band consumes the new page's whole text area; ordinary bands leave the two
%% columns to continue immediately below them.  NeoPage cannot safely emit an
%% otherwise-empty band page without disturbing its float/page state, so a
%% `fullpage' request also degrades to this page-top policy (with a warning).
\def\wbcc@elsevierplace{%
  \global\advance\wbcc@serial\@ne
  \wbcc@fptest
  \ifwbcc@fp
    \global\setbox\wbcc@hostband\box\wbcc@band
    \PackageWarningNoLine{wideband-cc}{Elsevier adapter: fullpage band
      \string##\the\wbcc@serial\space reduced to a next-page full-width top;
      NeoPage own-page output is not source-order safe}%
  \else
    \wbcc@frame\wbcc@hostband
  \fi
  %% NeoPage's wide-float gate replays the tail of a page that ends early unless the
  %% forced break is announced first; its own column switches do exactly this.
  \@ifundefined{SpaceReserveMarkColumnSwitchPage}{}{\SpaceReserveMarkColumnSwitchPage}%
  \wbcc@endpage
  %% The band box exactly as \@topnewpage builds it (content, then -\dbltextfloatsep,
  %% which \@combinedblfloats adds back), so an empty top area looks as before.
  \global\setbox\wbcc@hosttop\color@vbox\normalcolor\vbox{%
    \hsize\textwidth \@parboxrestore \col@number\@ne
    \vbox{\vskip\wbccskipabove
      \hb@xt@\textwidth{\hss\box\wbcc@hostband\hss}%
      \vskip\wbccskipbelow}%
    \vskip-\dbltextfloatsep}\color@endbox
  %% Its cost in the top area, by the kernel's own rule (\@addtodblcol): height plus
  %% \dbltextfloatsep when it is first there, \dblfloatsep after a wide float.
  \@tempdima\dimexpr\ht\wbcc@hosttop
    +\ifx\@dbltoplist\@empty\dbltextfloatsep\else\dblfloatsep\fi\relax
  \wbcc@queuedfalse
  \ifdim\dimexpr\@colroom-\@tempdima\relax<2.5\baselineskip\else
    \ifx\@freelist\@empty\else\wbcc@queuedtrue\fi
  \fi
  \ifwbcc@queued
    %% Pending floats stay queued: the page they start (this one) already holds
    %% whatever the kernel placed at its top; the band joins the full-width top area
    %% after any wide float there, and the columns shrink by its cost.
    \PackageInfo{wideband-cc}{band \string##\the\wbcc@serial\space
      (page \the\c@page): Elsevier adapter; full-width top of this page, pending
      floats stay queued}%
    \@next\@currbox\@freelist{}{}%
    \global\setbox\@currbox\box\wbcc@hosttop
    \global\count\@currbox\tw@
    \@cons\@dbltoplist\@currbox
    \global\@dbltopnum\m@ne
    \global\advance\@colht-\@tempdima
    \global\advance\@colroom-\@tempdima
    \global\vsize\@colroom
    %% NeoPage re-applies its float reservations for the new top area here too:
    %% measured on 55 Elsevier articles, leaving this out made 23 lose text.
    \@ifundefined{spacereserve@syncaftermodeswitch}{}{\spacereserve@syncaftermodeswitch}%
  \else
    %% No room beside what is already queued for this page (or no free float box):
    %% flush the queue onto pages of its own first, then open the top area there.
    \PackageInfo{wideband-cc}{band \string##\the\wbcc@serial\space
      (page \the\c@page): Elsevier adapter; pending floats flushed first (no room
      beside them), then next-page full-width top}%
    \clearpage
    \twocolumn[{\unvbox\wbcc@hosttop\vskip\dbltextfloatsep}]%
    %% \twocolumn resets \@colroom to \@colht. NeoPage's contract for column-mode
    %% switches is to re-apply its float reservations right after; without this a
    %% reserved float lands in a full-height column (AA_9001 overflowed 454pt).
    \@ifundefined{spacereserve@syncaftermodeswitch}{}{\spacereserve@syncaftermodeswitch}%
  \fi
  \directlua{wbcc.putinserts()}}% the band's footnotes go on the band's page
%% End the current page WITHOUT \clearpage, so pending floats are not flushed. A page
%% with nothing on it yet (band authored at the top of column 1) is kept: the band
%% opens its top area. Otherwise end the column; if that leaves us in column 2, end
%% the page with an empty column 2.
\newif\ifwbcc@queued
\newbox\wbcc@hosttop
\def\wbcc@endpage{%
  \par
  \ifdim\pagegoal=\maxdimen\else\newpage\fi
  \if@firstcolumn\else\null\newpage\fi}

%% OPERATOR ERRORS. Bands are placed by hand (mr-bean), in one compile. When a band
%% does not end up where it was written, the operator must hear about it, and an
%% editor that lists only `!' lines from the log never shows a warning. So each such
%% case is a LaTeX error naming the band (#n in document order), the input line of
%% its \end{wideband} and the page; the run continues. Each kind of problem is
%% reported once per band.
\def\wbcc@operror#1#2#3#4{% #1 pool slot, #2 kind, #3 what happened, #4 what to do
  \edef\wbcc@tmp{\csname wbcc@id@#1\endcsname}%
  \@ifundefined{wbcc@rep@#2@\wbcc@tmp}{%
    \expandafter\gdef\csname wbcc@rep@#2@\wbcc@tmp\endcsname{}%
    \PackageError{wideband-cc}{band \wbcc@tmp\space (input line
      \csname wbcc@ln@#1\endcsname) #3}{#4}}{}}
%% A page that prints past its text area by more than this, after a band has changed
%% the pagination, is reported (NeoPage's float plan reserves room for figures page by
%% page; text a band pushes forward can collide with it and run off the page, taking
%% text or a figure with it). NeoPage's own band-free pages overflow by up to ~29pt
%% routinely in the Elsevier corpus, hence the default.
\newdimen\wbccoverflowlimit \wbccoverflowlimit=30\p@
\def\wbcc@movehelp{Make room on that page below the band's position (move or resize
  a figure or table there) or move the band, then compile again.}
\newif\ifwbcc@pagetop

%% Placement trace. Every decision about a band is logged with its serial number (#n in
%% document order) and the page it was decided on: a WARNING when a band cannot go where
%% it was written (deferred to the top of the next page, held back by the per-page limit
%% or a full-page band ahead of it), an INFO line when it is placed, moves to the next
%% page together with its text, or is set on a page of its own. Grep the log for
%% "wideband-cc" to audit a document's bands.
\def\wbcc@logW#1#2{\PackageWarningNoLine{wideband-cc}{band \string##\csname wbcc@id@#1\endcsname\space
  (page \the\c@page): #2}}
\def\wbcc@logI#1#2{\PackageInfo{wideband-cc}{band \string##\csname wbcc@id@#1\endcsname\space
  (page \the\c@page): #2}}
%% Everything decided on this page, from the pool state after \wbcc@duecount:
%% placed 1..nb; leftover overdue nb+1..overdue (only when m=0); deferred-new
%% overdue+m+1..overdue+found, of which the first #1 shipped their marker here and the
%% rest ride the overflow. A deferred-new band beyond \wbcc@cap was held back (limit /
%% full-page band ahead), one within it was shed for room.
\def\wbcc@logpage#1{%
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@nb+\@ne\relax\do{%
    \wbcc@logI{\the\wbcc@i}{placed, Y=\the\csname wbcc@Yd@\the\wbcc@i\endcsname}%
    \advance\wbcc@i\@ne}%
  \wbcc@i\numexpr\wbcc@nb+\@ne\relax
  \@whilenum\wbcc@i<\numexpr\wbcc@overdue+\@ne\relax\do{%
    \ifnum\csname wbcc@fp@\the\wbcc@i\endcsname=\@ne
      \wbcc@logI{\the\wbcc@i}{full-page band, set on a page of its own after this page}%
    \else
      \wbcc@logW{\the\wbcc@i}{held back (per-page limit, or a full-page band precedes
        it); placed at the top of a following page}%
      \wbcc@operror{\the\wbcc@i}{held}{cannot be placed on page \the\c@page: at most
        \the\wbcc@MAX\space bands fit a page, or a full-page band comes first. It is
        set at the top of a following page}{\wbcc@movehelp}%
    \fi
    \advance\wbcc@i\@ne}%
  \wbcc@i\numexpr\wbcc@overdue+\wbcc@m+\@ne\relax
  \@whilenum\wbcc@i<\numexpr\wbcc@overdue+\wbcc@found+\@ne\relax\do{%
    \ifnum\csname wbcc@fp@\the\wbcc@i\endcsname=\@ne
      \wbcc@logI{\the\wbcc@i}{full-page band; set on a page of its own once the text it
        follows has shipped}%
    \else\ifnum\wbcc@i>\numexpr\wbcc@overdue+\wbcc@m+#1\relax
      \wbcc@logI{\the\wbcc@i}{moves to the next page together with the text it follows}%
    \else\ifnum\wbcc@i>\wbcc@cap
      \wbcc@logW{\the\wbcc@i}{held back (per-page limit, or a full-page band precedes
        it); placed at the top of a following page}%
      \wbcc@operror{\the\wbcc@i}{held}{cannot be placed on page \the\c@page: at most
        \the\wbcc@MAX\space bands fit a page, or a full-page band comes first. It is
        set at the top of a following page}{\wbcc@movehelp}%
    \else
      \wbcc@logW{\the\wbcc@i}{deferred - no room for it on this page (a band page holds
        less text than a plain one); placed at the top of the next page}%
      \wbcc@operror{\the\wbcc@i}{defer}{does not fit on page \the\c@page\space where it is
        written. It is set at the top of the next page, after the text that follows
        it}{\wbcc@movehelp}%
    \fi\fi\fi
    \advance\wbcc@i\@ne}}

%% Emit every full-page band at the FRONT of the pool whose text has shipped (it is
%% overdue) as a page of its own: the band centred on an otherwise empty page, no rows,
%% no rules. Called right after the text page is shipped (both output branches) and
%% at the end of the document. A full-page band further back in the pool waits until
%% the bands before it are placed, so bands never change order; a full-page band whose
%% marker rides in the overflow is not overdue yet and waits for its text.
\def\wbcc@emitfullpages{%
  \wbcc@morefalse
  \ifnum\wbcc@overdue>\z@ \ifnum\csname wbcc@fp@1\endcsname=\@ne \wbcc@moretrue \fi\fi
  \ifwbcc@more
    \wbcc@logI{1}{set on a page of its own}%
    %% NeoPage plans floats by physical page: this page is not in its plan, and floats
    %% planned for this page number are then not set here, and can be lost (5 of 10
    %% NeoPage test builds, with no error). Later ones each move one page later.
    \directlua{wbcc.planned(\the\c@page)}%
    \ifx\wbcc@planned\@empty\else
      \wbcc@operror{1}{fullpage}{is set on page \the\c@page, a page of its own, but
        NeoPage's float plan puts \wbcc@planned\space on page \the\c@page: they can be
        lost or set elsewhere}{In the float panel, move every figure and table planned
        on page \the\c@page\space or later one page later (or make the band shorter
        than a page), then compile again.}%
    \fi
    \setbox\@outputbox\vbox to\textheight{%
      \vskip\z@\@plus\@ne fil
      \hb@xt@\textwidth{\hss\box\csname wbcc@b@1\endcsname\hss}%
      \vskip\z@\@plus\@ne fil}%
    %% Running heads: the kernel recomputes the "page" mark structure in \@opcol, BEFORE
    %% \@outputdblcol, so a page shipped from inside the same call would reuse the text
    %% page's marks (\rightmark = that page's FIRST mark — stale if a section began on
    %% it; stock float pages show exactly that). Run the kernel's single-column update
    %% on the band box: it has no marks, so top = first = last = the previous page's
    %% last mark — the section current when the band page begins — and the next text
    %% page's "previous-page" structure follows from it. Older kernels (no ltmarks)
    %% re-derive legacy \firstmark from \botmark in \@outputpage themselves.
    \ifdefined\@expl@@@mark@update@singlecol@structures@@
      \@expl@@@mark@update@singlecol@structures@@
    \fi
    \@outputpage
    \global\@colht\textheight
    \wbcc@nb\@ne \wbcc@shiftpool \global\wbcc@nb\z@
    \global\advance\wbcc@overdue\m@ne
    \expandafter\wbcc@emitfullpages
  \fi}

%% A band taller than the text area fits no page: it would overprint the page foot.
%% Like a page's last line, its depth may hang below \textheight up to \maxdepth, and
%% the excess is judged with \vfuzz, the tolerance TeX itself uses for overfull boxes.
\def\wbcc@checkheight{%
  \ifdim\ht\wbcc@band>\dimexpr\textheight+\vfuzz\relax \wbcc@toolarge \else
    \ifdim\dp\wbcc@band>\maxdepth
      \ifdim\dimexpr\ht\wbcc@band+\dp\wbcc@band\relax>\dimexpr\textheight+\vfuzz\relax
        \wbcc@toolarge \fi\fi
  \fi}
\def\wbcc@toolarge{%
  \PackageError{wideband-cc}{band number \the\numexpr\wbcc@serial+\@ne\relax\space
    is taller than the text area}{It cannot fit on any page and will overprint the
    page foot. Shorten or split the band.}}

%% Per-band options: \begin{wideband}[<keys>]. Keys: y=<dimen> (explicit split height),
%% skipabove=, skipbelow=, framesep=, rulewidth= (this band's spacing), fullpage (a page
%% of its own regardless of size). A bare dimension, [300pt], still means y=300pt. The
%% settings are local to the environment, which is exactly the scope \wbcc@capture reads
%% at \end{wideband}.
%% y=<dimen>, or y=top (Y=0) / y=bottom (as low as the page allows: \wbcc@ymax, resolved
%% per attempt in \wbcc@autoY like an automatic Y, and never a clamp error). The bottom
%% sentinel is a dimension no real Y reaches, distinct from the AUTO sentinel \maxdimen.
\newdimen\wbcc@bottomY \wbcc@bottomY=16383\p@
\def\wbcc@ykw@top{top}\def\wbcc@ykw@bottom{bottom}
\def\wbcc@sety#1{%
  \def\wbcc@ykw{#1}%
  \ifx\wbcc@ykw\wbcc@ykw@top \def\wbcc@curY{\z@}\else
  \ifx\wbcc@ykw\wbcc@ykw@bottom \def\wbcc@curY{\wbcc@bottomY}\else
  \def\wbcc@curY{#1}\fi\fi}
\define@key{wbcc}{y}{\wbcc@sety{#1}}
\define@key{wbcc}{skipabove}{\setlength\wbccskipabove{#1}}
\define@key{wbcc}{skipbelow}{\setlength\wbccskipbelow{#1}}
\define@key{wbcc}{framesep}{\setlength\wbccframesep{#1}}
\define@key{wbcc}{rulewidth}{\setlength\wbccrulewidth{#1}}
\define@key{wbcc}{fullpage}[true]{\csname wbcc@fpforce#1\endcsname}
\define@key{wbcc}{rules}{\wbccrulestyle{#1}}      % revtex | mirror | column | none, this band
\def\wbcc@fullpagekey{fullpage}
\def\wbcc@setopts#1{%
  \def\wbcc@tmp{#1}%
  \ifx\wbcc@tmp\@empty \else
    \ifx\wbcc@tmp\wbcc@fullpagekey \setkeys{wbcc}{#1}%
    \else
      \in@{=}{#1}%
      \ifin@ \setkeys{wbcc}{#1}\else \wbcc@sety{#1}\fi   % no "=": a bare Y (or top/bottom)
    \fi
  \fi}

\newenvironment{wideband}[1][\wbcc@detachY]{%
  \wbcc@fpforcefalse
  \def\wbcc@curY{\wbcc@detachY}%   % Y and the spacing for THIS band; #1 is not visible
  \wbcc@setopts{#1}%               % in \end, so resolve the options here (locally)
  \par
  \setbox\wbcc@band\vbox\bgroup
    \hsize\textwidth \columnwidth\textwidth \linewidth\textwidth
}{%
  \egroup
  \directlua{wbcc.takeinserts(\number\wbcc@band)}% footnotes leave the box; re-added below
  \wbcc@checkheight
  \ifinner
    %% Inside a box (float, minipage, a host's boxed float that may be typeset more
    %% than once for measurement): a marker here never reaches a column and a page
    %% break is illegal, so neither adapter can place it. Set it in place instead.
    \PackageInfo{wideband-cc}{band inside a box (float, minipage or host box):
      set inline where it was authored}%
    \wbcc@inline
  \else\if@twocolumn
    %% The host has replaced the two-column routine since \begin{document} (NeoPage's
    %% \lastpagebalance installs its own for the last pages): no page of ours would see
    %% this band's marker, and it would be lost. Set it page-top instead, and say so.
    \wbcc@pagetopfalse
    \ifwbcc@elsevieradapter\else
      \ifx\@outputdblcol\wbcc@outputdblcol\else \wbcc@pagetoptrue \fi
    \fi
    \ifwbcc@elsevieradapter
      \wbcc@elsevierplace
    \else\ifwbcc@pagetop
      \PackageError{wideband-cc}{band \the\numexpr\wbcc@serial+\@ne\relax\space (input
        line \the\inputlineno) cannot be placed mid-page here: the two-column page
        routine was replaced before it (NeoPage \string\lastpagebalance). It is set at
        the top of the next page}{Move the band before \string\lastpagebalance\space (or
        the command that replaced the routine), or accept the page-top position.}%
      \wbcc@elsevierplace
    \else
      \ifnum\wbcc@np<\numexpr\wbcc@MAX+\@ne\relax   % pool holds MAX+1 (placement caps at MAX/page)
        \global\advance\wbcc@np\@ne
        \expandafter\wbcc@capture\csname wbcc@b@\the\wbcc@np\endcsname{\the\wbcc@np}%
        \global\csname wbcc@Yd@\the\wbcc@np\endcsname=\wbcc@curY\relax
        \directlua{wbcc.mark()}%   % leave a marker at the authored position (page assignment)
        \directlua{wbcc.putinserts()}% its footnotes ride with the marker to the band's page
      \else
        \PackageError{wideband-cc}{too many bands waiting for placement (\the\wbcc@np\space
          already pending)}{At most \the\wbcc@MAX\space bands are placed per page and a band
          waits until the text it follows ships. Move this band further into the text.
          It is typeset in the flow here so that nothing is lost.}%
        \wbcc@inline
      \fi
    \fi\fi
  \else
    \wbcc@inline                   % one column: no output routine of ours runs
  \fi\fi
}

%% A band deferred on the document's last page (its marker sat past the band page's
%% budget) has no next page to land on: give it one instead of losing it. Then any band
%% still pending never had its marker seen at a column's top level (e.g. authored inside
%% a box) — say so rather than drop it silently.
%% Runs AFTER the kernel's own final \clearpage (enddocument/afterlastpage), not from
%% \AtEndDocument: an \AtEndDocument \clearpage would ship the last page before
%% flushend gets to balance it. Older kernels without that hook fall back.
\def\wbcc@atveryend{%
  \wbcc@emitfullpages
  \ifnum\wbcc@overdue>\z@ \null\clearpage \fi
  %% Any band still pending was never placed: its marker never reached one of our
  %% pages (e.g. the band was captured just before the host replaced the two-column
  %% routine for its last page). Rather than lose it, report it and set each on a
  %% page of its own at the end.
  \ifnum\wbcc@np>\z@
    \wbcc@i\@ne
    \@whilenum\wbcc@i<\numexpr\wbcc@np+\@ne\relax\do{%
      \wbcc@operror{\the\wbcc@i}{never}{could not be placed where it is written: its page
        was built by another page routine (such as NeoPage's last-page balancing). It
        is set on a page of its own at the end of the document}{Move the band earlier,
        onto a page before the last one (or before \string\lastpagebalance), then
        compile again.}%
      \expandafter\gdef\csname wbcc@fp@\the\wbcc@i\endcsname{1}%
      \advance\wbcc@i\@ne}%
    \global\wbcc@overdue\wbcc@np
    \wbcc@emitfullpages
  \fi}
\ifdefined\AddToHook
  \AddToHook{enddocument/afterlastpage}{\wbcc@atveryend}
\else
  \AtEndDocument{\clearpage\wbcc@atveryend}
\fi


%% Finish one column segment #1 (a box register) that \wbcc@splitcol just produced
%% with \vsplit ... to X. \vsplit packages the segment EXACTLY to X, but TeX may have
%% reached X by SHRINKING glue (\medskip has minus 2pt), and the old \unvbox in the row
%% dropped that glue-set, letting the row re-expand to its natural height — past X and
%% past the budget (measured +6.56pt on one row; only at split points where the best
%% break needed shrink, hence the "resonance"). So:
%%   - natural size > the set size (vsplit shrank): keep the box as set — the same
%%     thing stock \flushbottom does at a column bottom;
%%   - otherwise, under \flushbottom (\@textbottom is \relax): fill the row exactly to X
%%     the way \@makecol finishes a column (\unvbox, back up the last depth), so the
%%     glue stretches and both columns end level at the band;
%%   - otherwise (\raggedbottom): rebox to the NATURAL height (<= X), so glue stays
%%     natural and the band follows the taller column's last line, not a fixed Y.
%% In every branch the box is no taller than X + \maxdepth-clamped depth, so the rows
%% sum to at most \wbcc@bud + (N+1)\maxdepth and \wbcc@computebud's reserve bounds the
%% page: no split height can overflow it. \boxmaxdepth\maxdepth mirrors \vsplit's
%% \splitmaxdepth so a deep last line moves into the height, never past the reserve.
\def\wbcc@fitseg#1{%
  \setbox\@tempboxa\vbox{\boxmaxdepth\maxdepth\unvcopy#1}%   natural size of the content
  \ifdim\dimexpr\ht\@tempboxa+\dp\@tempboxa\relax>\dimexpr\ht#1+\dp#1\relax
  \else
    \ifx\@textbottom\relax
      \dimen@\dp\@tempboxa
      \setbox#1\vbox to\ht#1{\unvbox#1\vskip-\dimen@}%
    \else
      \setbox#1\box\@tempboxa
    \fi
  \fi}


%% Split one recombined column (already in \wbcc@galley) into up to \wbcc@nb+1 segments:
%% segment i (i=1..nb) is the text row ABOVE band i. #1 is L or R; run \wbcc@sortidx
%% first, and L before R.
%%
%% Split targets are ABSOLUTE. \vsplit stops at a line boundary, so a segment consumes
%% less than its target; if segment i+1 were split to "Y_{i+1} - Y_i" from wherever
%% segment i actually ended, its reach would drift up by the accumulated residual and a
%% band's row could stop one line short of the paragraph the band follows (reported: the
%% last line of the paragraph appeared below the band). So in the column that READS band
%% i (\wbcc@sd@i), segment i is split to Y_i minus what this column has consumed so far
%% (\wbcc@used), which lands exactly at the marker whatever earlier rows did; in the right
%% column the target also carries \wbcc@rL, the residual the left column left in the
%% galley (the right column starts there, r < one line, so a right band's marker sits at
%% Y + r from its top). In the other column — its text just fills the row — the target is
%% the plain gap Y_i - Y_{i-1}. The last segment is split to \wbcc@bud - used, so a
%% column never exceeds its budget. A row may still be up to one line taller than its
%% nominal share (the catch-up), which \wbcc@computebud reserves per band.
%%
%% A gap below one \baselineskip — two bands at equal or near-equal Y — holds no text: the
%% row is voided (segment i empty) and the bands stack; the split point does NOT advance,
%% so band i+1 measures its gap from the same point (a degenerate \vsplit to ~0pt would
%% still take a whole line).
%% Rows are numbered i = 1..nb in Y order; row i belongs to the band at pool position
%% \wbcc@ord@i (\wbcc@sortidx). Segments are stored per ROW (\wbcc@L@i / \wbcc@R@i).
%% The last row (nb+1) is split to bud - used - \wbcc@lastcut (the attempt loop shortens
%% it when the measured page overshoots) and is left EMPTY when less than a line remains
%% (a \vsplit to a sub-line height would still take a whole line): a band may be the
%% last thing on a page.
\def\wbcc@splitcol#1{%
  \wbcc@prevY\z@
  \wbcc@gstart\dimexpr\ht\wbcc@galley+\dp\wbcc@galley\relax   % galley height as this column starts
  \if L#1\wbcc@rL\z@\fi                                    % no offset for the left column
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@nb+\@ne\relax\do{%
    \edef\wbcc@k{\csname wbcc@ord@\the\wbcc@i\endcsname}%  the band of row i
    \wbcc@used\dimexpr\wbcc@gstart-\ht\wbcc@galley-\dp\wbcc@galley\relax
    \if#1\csname wbcc@sd@\wbcc@k\endcsname                % this column reads the band
      \@tempdima\dimexpr\csname wbcc@Yd@\wbcc@k\endcsname+\wbcc@rL-\wbcc@used\relax
    \else
      \@tempdima\dimexpr\csname wbcc@Yd@\wbcc@k\endcsname-\wbcc@prevY\relax
    \fi
    \ifdim\@tempdima<\baselineskip
      \setbox\csname wbcc@#1@\the\wbcc@i\endcsname\box\voidb@x   % stacked band: no text row
    \else
      \setbox\csname wbcc@#1@\the\wbcc@i\endcsname\vsplit\wbcc@galley to\@tempdima
      \expandafter\wbcc@fitseg\csname wbcc@#1@\the\wbcc@i\endcsname
      \wbcc@prevY\csname wbcc@Yd@\wbcc@k\endcsname
    \fi
    \advance\wbcc@i\@ne}%
  \wbcc@used\dimexpr\wbcc@gstart-\ht\wbcc@galley-\dp\wbcc@galley\relax
  \@tempdima\dimexpr\wbcc@bud-\wbcc@used-\wbcc@lastcut\relax
  \ifdim\@tempdima<\baselineskip
    \setbox\csname wbcc@#1@\the\wbcc@i\endcsname\box\voidb@x     % nothing below the last band
  \else
    \setbox\csname wbcc@#1@\the\wbcc@i\endcsname\vsplit\wbcc@galley to\@tempdima
    \expandafter\wbcc@fitseg\csname wbcc@#1@\the\wbcc@i\endcsname
  \fi
  \if L#1% the residual the left column leaves: where the right column really starts
    \wbcc@rL\dimexpr\wbcc@bud-\wbcc@gstart+\ht\wbcc@galley+\dp\wbcc@galley\relax
    \ifdim\wbcc@rL<\z@ \wbcc@rL\z@ \fi
  \fi
}

%% Index sort: \wbcc@ord@1..nb = the placed bands' pool positions in ascending Y (stable
%% bubble sort, nb <= 4). The pool itself stays in source order, so marker indices keep
%% matching pool positions and the attempt loop can run the whole placement again.
\def\wbcc@sortidx{%
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@nb+\@ne\relax\do{%
    \ifdim\csname wbcc@Yd@\the\wbcc@i\endcsname=\maxdimen
      \PackageError{wideband-cc}{auto Y unresolved for a placed band}{\string\wbcc@autoY\space
        must run before \string\wbcc@sortidx}\fi
    \expandafter\xdef\csname wbcc@ord@\the\wbcc@i\endcsname{\the\wbcc@i}%
    \advance\wbcc@i\@ne}%
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\wbcc@nb\do{%
    \wbcc@j\@ne
    \@whilenum\wbcc@j<\numexpr\wbcc@nb-\wbcc@i+\@ne\relax\do{%
      \edef\wbcc@next{\the\numexpr\wbcc@j+\@ne\relax}%
      \@tempdima\csname wbcc@Yd@\csname wbcc@ord@\the\wbcc@j\endcsname\endcsname
      \@tempdimb\csname wbcc@Yd@\csname wbcc@ord@\wbcc@next\endcsname\endcsname
      \ifdim\@tempdima>\@tempdimb
        \edef\wbcc@tmp{\csname wbcc@ord@\the\wbcc@j\endcsname}%
        \expandafter\xdef\csname wbcc@ord@\the\wbcc@j\endcsname{\csname wbcc@ord@\wbcc@next\endcsname}%
        \expandafter\xdef\csname wbcc@ord@\wbcc@next\endcsname{\wbcc@tmp}%
      \fi
      \advance\wbcc@j\@ne}%
    \advance\wbcc@i\@ne}}

%% Height of band #1's cue-rule boxes (0 when it has none), into \dimen@.
\def\wbcc@cueextra#1{%
  \edef\wbcc@tmp{\csname wbcc@rs@#1\endcsname}%
  \expandafter\wbcc@rulesides\expandafter{\wbcc@tmp}{\csname wbcc@sd@#1\endcsname}%
  \dimen@\z@
  \if N\wbcc@above\else
    \dimen@\ifdim\wbccruletick>\wbccrulewidth \wbccruletick\else\wbccrulewidth\fi
  \fi
  \if N\wbcc@below\else \advance\dimen@\dimexpr\wbccrulewidth+\wbccruletick\relax \fi}

%% Exactly what \wbcc@assemble + the last row + the bottom block will stack, from the
%% boxes: rows (the taller segment; a row with no segment adds nothing, and skips its
%% band's skip-above like the assembly does), bands with their skips and cue rules, the
%% bottom block. Into \wbcc@total.
\def\wbcc@measure{%
  \wbcc@total\dimexpr\ht\wbcc@bot+\dp\wbcc@bot\relax
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@nb+\tw@\relax\do{%
    \wbcc@rowfalse
    \ifvoid\csname wbcc@L@\the\wbcc@i\endcsname
      \ifvoid\csname wbcc@R@\the\wbcc@i\endcsname\else\wbcc@rowtrue\fi
    \else\wbcc@rowtrue\fi
    \@tempdimb\dimexpr\ht\csname wbcc@L@\the\wbcc@i\endcsname+\dp\csname wbcc@L@\the\wbcc@i\endcsname\relax
    \@tempdimd\dimexpr\ht\csname wbcc@R@\the\wbcc@i\endcsname+\dp\csname wbcc@R@\the\wbcc@i\endcsname\relax
    \ifdim\@tempdimd>\@tempdimb \@tempdimb\@tempdimd \fi
    \advance\wbcc@total\@tempdimb
    \ifnum\wbcc@i>\wbcc@nb\else
      \edef\wbcc@k{\csname wbcc@ord@\the\wbcc@i\endcsname}%
      \wbcc@cueextra{\wbcc@k}%
      \advance\wbcc@total\dimexpr\ht\csname wbcc@b@\wbcc@k\endcsname+\dp\csname wbcc@b@\wbcc@k\endcsname
        +\csname wbcc@bl@\wbcc@k\endcsname+\dimen@\relax
      \ifwbcc@row \advance\wbcc@total\csname wbcc@ab@\wbcc@k\endcsname \fi
    \fi
    \advance\wbcc@i\@ne}}

%% Which placed bands have an automatic Y (so a re-run of \wbcc@autoY can resolve them
%% again): snapshot before the first attempt, restore before every attempt.
\def\wbcc@snapauto{%
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@nb+\@ne\relax\do{%
    \ifdim\csname wbcc@Yd@\the\wbcc@i\endcsname=\maxdimen
      \expandafter\def\csname wbcc@au@\the\wbcc@i\endcsname{1}%
    \else\ifdim\csname wbcc@Yd@\the\wbcc@i\endcsname=\wbcc@bottomY
      \expandafter\def\csname wbcc@au@\the\wbcc@i\endcsname{2}%  y=bottom: re-resolved too
    \else
      \expandafter\def\csname wbcc@au@\the\wbcc@i\endcsname{0}%
    \fi\fi
    \advance\wbcc@i\@ne}}
\def\wbcc@restoreY#1{%  the sentinel band #1 had before the attempts, from its \wbcc@au@ flag
  \ifnum\csname wbcc@au@#1\endcsname=\@ne \csname wbcc@Yd@#1\endcsname\maxdimen \fi
  \ifnum\csname wbcc@au@#1\endcsname=\tw@ \csname wbcc@Yd@#1\endcsname\wbcc@bottomY \fi}
\def\wbcc@resetauto{%
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@nb+\@ne\relax\do{%
    \wbcc@restoreY{\the\wbcc@i}%
    \advance\wbcc@i\@ne}}

%% A band the attempts shed (pool position > \wbcc@nb) may still hold the automatic Y
%% an attempt gave it on THIS page; \wbcc@shiftpool would carry that to the next page
%% as if it were explicit (a band shed to page 2 kept page 1's Y and printed below the
%% band after it, with a clamp warning). Give it the AUTO sentinel back.
\def\wbcc@unresolveshed{%
  \wbcc@i\numexpr\wbcc@nb+\@ne\relax
  \@whilenum\wbcc@i<\numexpr\wbcc@np+\@ne\relax\do{%
    \@ifundefined{wbcc@au@\the\wbcc@i}{}{\wbcc@restoreY{\the\wbcc@i}}%
    \advance\wbcc@i\@ne}}

%% A placed band whose explicit y the page could not honour (recorded by \wbcc@autoY in
%% the last attempt) was moved up: tell the operator, since an editor that lists only
%% errors would not show a warning.
\def\wbcc@reportclamps{%
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@nb+\@ne\relax\do{%
    \expandafter\ifx\csname wbcc@cl@\the\wbcc@i\endcsname\relax\else
      \expandafter\expandafter\expandafter\wbcc@clamperror
        \csname wbcc@cl@\the\wbcc@i\endcsname
    \fi
    \advance\wbcc@i\@ne}}
\def\wbcc@clamperror#1#2#3{%
  \wbcc@operror{\the\wbcc@i}{clamp}{has y=#1, which leaves no room for the band and a
    line below it on page \the\c@page. It is placed at y=#2 instead}{Use a y of at most
    #3, or remove y to place the band automatically, then compile again.}}

%% One placement attempt on a fresh copy of the joined galley: budget, Y's, order, split,
%% measure. If the stack would overshoot \@colht: shorten the last row by the overshoot
%% and try again (it just gets less text); when the last row is already empty, shed the
%% last new band (it lands on the next page after its text), or, with only overdue bands
%% left, place one fewer. Bounded; the last attempt's boxes are the page.
\def\wbcc@attempt{%
  \setbox\wbcc@galley\copy\wbcc@gcopy
  \wbcc@resetauto
  \wbcc@computebud      % per-column budget for this set of bands
  \wbcc@autoY           % Y = marker's within-column height (auto), clamp (explicit), sides
  \wbcc@sortidx         % rows in ascending Y
  \wbcc@splitcol L
  \wbcc@splitcol R
  \wbcc@measure
  \wbcc@morefalse
  \ifdim\wbcc@total>\@colht
    \advance\wbcc@tries\@ne
    \ifnum\wbcc@tries<12
      \edef\wbcc@lr{\the\numexpr\wbcc@nb+\@ne\relax}%
      \@tempdimb\dimexpr\ht\csname wbcc@L@\wbcc@lr\endcsname+\dp\csname wbcc@L@\wbcc@lr\endcsname\relax
      \@tempdimd\dimexpr\ht\csname wbcc@R@\wbcc@lr\endcsname+\dp\csname wbcc@R@\wbcc@lr\endcsname\relax
      \ifdim\@tempdimd>\@tempdimb \@tempdimb\@tempdimd \fi
      \ifdim\@tempdimb>\z@
        \advance\wbcc@lastcut\dimexpr\wbcc@total-\@colht\relax
        \wbcc@moretrue
      \else\ifnum\wbcc@m>\z@
        \advance\wbcc@m\m@ne \wbcc@nb\numexpr\wbcc@overdue+\wbcc@m\relax
        \wbcc@lastcut\z@ \wbcc@moretrue
      \else\ifnum\wbcc@nb>\@ne
        \advance\wbcc@nb\m@ne \wbcc@lastcut\z@ \wbcc@moretrue
      \fi\fi\fi
    \else\ifnum\wbcc@m>\z@
      %% Out of tries and still over: cutting the last row did not shorten the page
      %% (NeoPage YJEMA_126557: each cut moved the left column's tail into a right
      %% segment that cannot split, which grew by the same amount). Keeping the band
      %% skips the check below, and its text may already ride in the overflow (the next
      %% page read pool slot 0). Shed the last new band, with fresh tries for the rest.
      \advance\wbcc@m\m@ne \wbcc@nb\numexpr\wbcc@overdue+\wbcc@m\relax
      \wbcc@lastcut\z@ \wbcc@tries\z@ \wbcc@moretrue
    \fi\fi
  \else\ifnum\wbcc@m>\z@
    %% It fits, but did every new band keep its text? Only this page's unplaced markers
    %% (\wbcc@found-\wbcc@m) may be left in the overflow. One more means the cut that
    %% fixed an overshoot also took the text a placed band follows — the band would
    %% print ahead of it (NeoPage EJMFLU_204268: a 91pt overshoot; its marker was then
    %% counted both placed and pending, and the next page read pool slot 0). Shed the
    %% last new band instead: it moves to the next page together with its text.
    \directlua{wbcc.countmarks(\number\wbcc@galley, \wbcc@ride@n)}%
    \ifnum\wbcc@ride>\numexpr\wbcc@found-\wbcc@m\relax
      \advance\wbcc@m\m@ne \wbcc@nb\numexpr\wbcc@overdue+\wbcc@m\relax
      \wbcc@lastcut\z@ \wbcc@moretrue
    \fi
  \fi\fi
  %% It fits by measure, but would a row print past the text area? A row holding
  %% material that cannot be split (a figure, NeoPage's reserved float space) taller
  %% than the row protrudes below the page (NeoPage APR_321: 366pt). Shed a band, as
  %% above: without it the host breaks that page normally.
  \ifwbcc@more\else
    \wbcc@protrudes
    \ifwbcc@over
      \ifnum\wbcc@m>\z@
        \advance\wbcc@m\m@ne \wbcc@nb\numexpr\wbcc@overdue+\wbcc@m\relax
        \wbcc@lastcut\z@ \wbcc@moretrue
      \else\ifnum\wbcc@nb>\@ne
        \advance\wbcc@nb\m@ne \wbcc@lastcut\z@ \wbcc@moretrue
      \fi\fi
    \fi
  \fi
  \ifwbcc@more \expandafter\wbcc@attempt \fi}

%% \ifwbcc@over <- some row segment of the current attempt is overfull at its own
%% height, i.e. prints past it (repacked as \wbcc@segtop will set it; TeX's \badness is
%% 1000000 exactly when a box is overfull; \vfuzz\maxdimen keeps the probe silent).
\newif\ifwbcc@over
\def\wbcc@segover#1{%
  \expandafter\ifvoid\csname#1\endcsname\else
    \begingroup
      \vfuzz\maxdimen \vbadness\@M
      \setbox\@tempboxa\vbox to\ht\csname#1\endcsname{\unvcopy\csname#1\endcsname}%
      \ifnum\badness>\@M \aftergroup\wbcc@overtrue \fi
    \endgroup
  \fi}
\def\wbcc@protrudes{%
  \wbcc@overfalse
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@nb+\tw@\relax\do{%
    \wbcc@segover{wbcc@L@\the\wbcc@i}\wbcc@segover{wbcc@R@\the\wbcc@i}%
    \advance\wbcc@i\@ne}}

%% One two-column row from segment #1.
\def\wbcc@row#1{%
  \hb@xt@\textwidth{%
    \hb@xt@\columnwidth{\expandafter\wbcc@segtop\csname wbcc@L@#1\endcsname\hss}%
    \hfil{\normalcolor\vrule\@width\columnseprule}\hfil
    \hb@xt@\columnwidth{\expandafter\wbcc@segtop\csname wbcc@R@#1\endcsname\hss}}%
}
%% A row segment as a \vtop holding the segment's LINES directly, so a text line sits
%% exactly as deep in the page as in a kernel column (measured: row hbox > column hbox
%% > \vtop > line mirrors \@outputbox > column hbox > column vbox > line). LuaTeX
%% requires a hyperlink's start and end at the same nesting depth, and a link may run
%% from a normal page onto a band page or back; the former \vtop{\box seg} put the
%% lines one level deeper and stopped such runs. `to \ht' re-sets the glue exactly as
%% the segment was set; \boxmaxdepth\maxdimen keeps its depth.
\def\wbcc@segtop#1{%
  \vtop to\ht#1{\boxmaxdepth\maxdimen \kern\z@ \unvbox#1}}

%% Interleave segments and bands: row1, [cue] band1 [cue], row2, band2, ..., row(nb+1).
%% Every piece is a box, so TeX would insert interline glue between them (a full
%% \baselineskip before a post-band row, since a \wbcc@row is a height-0 \vtop) —
%% unbudgeted height. \nointerlineskip before every piece keeps the stack exact: the
%% only vertical space is the band's own \wbcc@ab@/\wbcc@bl@ skips.
\def\wbcc@assemble{%
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@nb+\@ne\relax\do{%
    \edef\wbcc@k{\csname wbcc@ord@\the\wbcc@i\endcsname}%  the band of row i
    \wbcc@rowfalse                           % a row exists if either column has a segment
    \ifvoid\csname wbcc@L@\the\wbcc@i\endcsname
      \ifvoid\csname wbcc@R@\the\wbcc@i\endcsname\else\wbcc@rowtrue\fi
    \else\wbcc@rowtrue\fi
    \ifwbcc@row                              % (a stacked band has none)
      \wbcc@row{\the\wbcc@i}%
      \vskip\csname wbcc@ab@\wbcc@k\endcsname
    \fi
    \nointerlineskip
    \edef\wbcc@tmp{\csname wbcc@rs@\wbcc@k\endcsname}%  this band's rule style / column
    \expandafter\wbcc@rulesides\expandafter{\wbcc@tmp}{\csname wbcc@sd@\wbcc@k\endcsname}%
    \wbcc@cueabove\wbcc@above
    \nointerlineskip
    \hb@xt@\textwidth{\box\csname wbcc@b@\wbcc@k\endcsname\hss}%
    \nointerlineskip
    \wbcc@cuebelow\wbcc@below
    \vskip\csname wbcc@bl@\wbcc@k\endcsname
    \nointerlineskip
    \advance\wbcc@i\@ne}%
}
%% (The last row, nb+1, is added by the caller: under \flushbottom it is refilled first
%% to absorb the page's leftover, see \wbcc@refill.)

%% Refill segment #1 (a box register) so that its height+depth is exactly \@tempdimb,
%% if its natural content fits (a segment \vsplit had to shrink is left as set). Used
%% under \flushbottom on the last row's two segments so both columns end at the page's
%% bottom, like the columns of a plain \flushbottom page.
\def\wbcc@refill#1{%
  \setbox\@tempboxa\vbox{\boxmaxdepth\maxdepth\unvcopy#1}%
  \ifdim\dimexpr\ht\@tempboxa+\dp\@tempboxa\relax>\@tempdimb \else
    \@tempdimd\dp\@tempboxa
    \setbox#1\vbox to\@tempdimb{\unvbox#1\vskip-\@tempdimd}%
  \fi}

%% Per-column text budget for placing \wbcc@nb bands: \@colht minus the band heights
%% (+ their skips and cue rules), minus footnotes (\@tempdimc) and bottom floats
%% (\wbcc@bfh), minus a per-row depth reserve. Use \@colht (NOT \textheight): on a page carrying
%% a \dbltop float the columns were built at the reduced \@colht and \@combinedblfloats
%% adds the float back to reach \textheight, so budgeting on \textheight would
%% double-count. Each of the N+1 rows can carry up to \maxdepth of last-line depth, so
%% reserve (N+1)*\maxdepth. This is the ESTIMATE the placement starts from; the page is
%% then measured exactly (\wbcc@measure) and corrected (\wbcc@attempt) — no other
%% reserve is needed. The caller sets \@tempdimc/\wbcc@bfh.
\def\wbcc@computebud{%
  \@tempdima\z@
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@nb+\@ne\relax\do{%
    \advance\@tempdima\dimexpr\ht\csname wbcc@b@\the\wbcc@i\endcsname
      +\dp\csname wbcc@b@\the\wbcc@i\endcsname
      +\csname wbcc@ab@\the\wbcc@i\endcsname+\csname wbcc@bl@\the\wbcc@i\endcsname
      +\tw@\wbccrulewidth+\tw@\wbccruletick\relax        % its two cue rules + ticks (slack for a top band)
    \advance\wbcc@i\@ne}%
  \wbcc@i\numexpr\wbcc@nb+\@ne\relax
  \@tempdimd\maxdepth \multiply\@tempdimd\wbcc@i         % (N+1)*\maxdepth: row last-line depths
  \wbcc@bud\dimexpr\@colht-\@tempdima-\@tempdimc-\wbcc@bfh-\@tempdimd\relax
}

%% Automatic split height Y for each placed band whose \wbcc@Yd@i is still the AUTO
%% sentinel (\maxdimen). Y = the marker's height WITHIN its own rebuilt column, so the
%% band appears where it was authored:
%%   - a NEW band (pool position i > \wbcc@overdue) reads its marker's galley position
%%     P = \wbcc@mh@(i-\wbcc@overdue). The rebuilt page is [col1|col2] cut at \wbcc@bud,
%%     so a marker with P<=\wbcc@bud sits in the left column (Y=P) and one with P>\wbcc@bud
%%     in the right column (Y=P-\wbcc@bud, the detach-up placement). \wbcc@bud IS the L/R
%%     boundary because \wbcc@splitcol's L segments sum to exactly \wbcc@bud.
%%   - an OVERDUE band (pool position i <= \wbcc@overdue) was deferred from an earlier page
%%     and has NO marker here (they were stripped), so it lands at the top (Ymin).
%% Clamp to [Ymin, \wbcc@ymax]: Ymin = one \baselineskip (never flush to the header);
%% \wbcc@ymax = \wbcc@bud - (tallest placed band) - gaps - \baselineskip guarantees the
%% band plus one line below still fit. Clamping is monotone so it cannot reorder bands;
%% near-equal clamped Y's are de-collided by \wbcc@sortidx + the \wbcc@splitcol stack.
%% MUST run AFTER \wbcc@computebud (needs \wbcc@bud) and BEFORE \wbcc@sortidx (the marker
%% index i-\wbcc@overdue tracks the UNSORTED pool order, which the sort permutes). The N>1
%% clamp is deliberately simple (one page-wide \wbcc@ymax from the tallest band); see
%% docs/design-auto-y-source.md.
\def\wbcc@autoY{%
  \@tempdima\z@                                   % tallest placed band (ht+dp+its skips)
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@nb+\@ne\relax\do{%
    \@tempdimb\dimexpr\ht\csname wbcc@b@\the\wbcc@i\endcsname
      +\dp\csname wbcc@b@\the\wbcc@i\endcsname
      +\csname wbcc@ab@\the\wbcc@i\endcsname+\csname wbcc@bl@\the\wbcc@i\endcsname\relax
    \ifdim\@tempdimb>\@tempdima \@tempdima\@tempdimb \fi
    \advance\wbcc@i\@ne}%
  \wbcc@ymax\dimexpr\wbcc@bud-\@tempdima\relax           % the band itself must still fit below Y
  \ifdim\wbcc@ymax<\z@ \wbcc@ymax\z@ \fi                      % degenerate page: no inverted range
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@nb+\@ne\relax\do{%
    %% which column reads this band (for the cue rules): its marker's column — L if the
    %% galley position P is within the left column's budget, R beyond it; an overdue band
    %% has no marker here and lands at the top: T (no rules).
    \ifnum\wbcc@i>\wbcc@overdue
      \edef\wbcc@mk{\the\numexpr\wbcc@i-\wbcc@overdue\relax}%   marker index (unsorted order)
      \ifdim\csname wbcc@mh@\wbcc@mk\endcsname>\wbcc@bud
        \expandafter\gdef\csname wbcc@sd@\the\wbcc@i\endcsname{R}%
      \else
        \expandafter\gdef\csname wbcc@sd@\the\wbcc@i\endcsname{L}%
      \fi
    \else
      \expandafter\gdef\csname wbcc@sd@\the\wbcc@i\endcsname{T}%
    \fi
    \@tempdimb\csname wbcc@Yd@\the\wbcc@i\endcsname
    \ifdim\@tempdimb=\maxdimen                     % auto sentinel -> derive from marker
      \ifnum\wbcc@i>\wbcc@overdue
        \@tempdimb\csname wbcc@mh@\wbcc@mk\endcsname             % galley position P
        \ifdim\@tempdimb>\wbcc@bud \advance\@tempdimb-\wbcc@bud \fi  % right column: P-\wbcc@bud
      \else
        \@tempdimb\z@                              % overdue band: its text ended on the
      \fi                                          % previous page -> the very top, Y=0
      \wbcc@clampY
    \else\ifdim\@tempdimb=\wbcc@bottomY           % y=bottom: the band ends the page
      %% Y = the whole text budget: the row below the band is then shorter than a line
      %% and \wbcc@splitcol leaves it empty, so the band is the last thing on the page
      %% and the text after it goes on to the next page (the stack is still bud + band,
      %% within \@colht by construction). Not \wbcc@ymax, which keeps a band's height of
      %% text under the band.
      \@tempdimb\wbcc@bud
      \expandafter\let\csname wbcc@cl@\the\wbcc@i\endcsname\relax
    \else                                          % explicit [Y] / \wbccReserve: same
      \dimen@\@tempdimb                            % clamp, but say so — the author asked
      \wbcc@clampY                                 % for a Y the page cannot honour
      \expandafter\let\csname wbcc@cl@\the\wbcc@i\endcsname\relax
      \ifdim\dimen@=\@tempdimb\else                % reported after the attempts, if
        \expandafter\edef\csname wbcc@cl@\the\wbcc@i\endcsname{%   the band stays here
          {\the\dimen@}{\the\@tempdimb}{\the\wbcc@ymax}}%
      \fi
    \fi\fi
    \ifdim\@tempdimb=\z@                           % nothing above it: no cue rules
      \expandafter\gdef\csname wbcc@sd@\the\wbcc@i\endcsname{T}%
    \fi
    \csname wbcc@Yd@\the\wbcc@i\endcsname\@tempdimb
    \advance\wbcc@i\@ne}%
}
%% Clamp \@tempdimb into [0, \wbcc@ymax]. For an AUTOMATIC band this is only a safety
%% net: \wbcc@duecount places a band on a page only if it has room below its own
%% position, so the clamp never moves one (moving it up would put the band above the
%% paragraph it follows); an EXPLICIT Y may be clamped, with a warning, since the author
%% asked for a height the page cannot honour. Ymin is 0, not a line: a marker sits between
%% paragraphs, so if any text precedes it on the page P is already >= one line, and a
%% band at Y=0 (P=0, or an overdue band) belongs at the very top — a positive Ymin
%% would only orphan one line of the NEXT paragraph above it. \wbcc@splitcol voids a
%% row shorter than a line, so Y=0 simply means "band first". \wbcc@ymax leaves the
%% band plus one line below it.
\def\wbcc@clampY{%
  \ifdim\@tempdimb<\z@ \@tempdimb\z@ \fi
  \ifdim\@tempdimb>\wbcc@ymax \@tempdimb\wbcc@ymax \fi}

%% Budget heights of the extracted footnote block (\wbcc@fn -> \@tempdimc: \skip\footins
%% + block + \footnoterule slack) and bottom floats (\wbcc@bfL/R -> \wbcc@bfh: the
%% taller side + \textfloatsep). Used twice per band page: once on the measurement
%% copies before the fit descent, once after the real extraction.
\def\wbcc@bottomdims{%
  \@tempdimc\z@
  \ifvoid\wbcc@fn\else
    \@tempdimc\dimexpr\skip\footins + \ht\wbcc@fn + \dp\wbcc@fn + 4\p@\relax
  \fi
  \wbcc@bfh\z@
  \ifvoid\wbcc@bfL\else \wbcc@bfh\dimexpr\ht\wbcc@bfL+\dp\wbcc@bfL\relax \fi
  \ifvoid\wbcc@bfR\else
    \@tempdimd\dimexpr\ht\wbcc@bfR+\dp\wbcc@bfR\relax
    \ifdim\@tempdimd>\wbcc@bfh \wbcc@bfh\@tempdimd \fi
  \fi
  \ifdim\wbcc@bfh>\z@ \advance\wbcc@bfh\textfloatsep \fi}

%% The band page's bottom block: re-set bottom floats, then the footnotes, boxed so its
%% exact height is known and the page can be measured. \boxmaxdepth\maxdepth (as in
%% \@makecol): a re-set float row is a height-0 \vtop whose whole float is DEPTH;
%% without the clamp that depth became the page box's depth and the float hung below
%% the text area — invisible to the overfull check, which only sees height (measured: a
%% [b] float's caption 65pt below the text bottom). Clamped, the excess moves into the
%% height, where the budget (\wbcc@bfh) already accounts for it. The notes are copied,
%% not consumed: notes that follow their callout to the next page leave \wbcc@fn after
%% the placement, and the block is built again.
\def\wbcc@makebot{%
  \setbox\wbcc@bot\vbox{%
    \boxmaxdepth\maxdepth
    \ifdim\wbcc@bfh>\z@
      \vskip\textfloatsep
      %% aligned at the bottom, as the columns set them: a host's wide float last in
      %% column 1 sits beside the room column 2 reserved for it, below a float above
      %% that room of any height (top-aligned, it printed over the taller one)
      \hb@xt@\textwidth{%
        \hb@xt@\columnwidth{\ifvoid\wbcc@bfL\else\vbox{\copy\wbcc@bfL\kern\z@}\fi\hss}%
        \hfil
        \hb@xt@\columnwidth{\ifvoid\wbcc@bfR\else\vbox{\copy\wbcc@bfR\kern\z@}\fi\hss}}%
    \fi
    \ifvoid\wbcc@fn\else
      \vskip\skip\footins \footnoterule \unvcopy\wbcc@fn
    \fi}}

%% How many bands to place on this page. The overdue prefix (bands deferred from an
%% earlier page) is always placed; the descent decides how many of THIS page's new
%% markers also fit. Bands are laid on the recombined galley [col1|col2], so a marker
%% at galley position P lands on this page iff P <= 2*\wbcc@bud (a col-1 marker below
%% \wbcc@bud simply becomes the top of the rebuilt right column — still on the page).
%% Galley order is document order, so the deepest fitting marker is the last one;
%% shrink \wbcc@m (fitting new markers) until marker \wbcc@m fits, then \wbcc@nb =
%% overdue + \wbcc@m. The caller has already set \@tempdimc / \wbcc@bfh to this page's
%% footnote and bottom-float heights (measured on COPIES of the columns, see
%% wbcc.measurebottom), so the descent uses the same budget the real split will: a
%% band whose text would be pushed off a page that also carries notes or floats is
%% deferred together with its text, never placed a page ahead of it.
\def\wbcc@duecount{%
  %% in-flow placements stop before the first FULL-PAGE band among the candidates
  %% (overdue + found): it gets its own page after this one, and bands after it must
  %% not overtake it. \wbcc@cap := min(MAX, that position - 1) is this page's cap.
  \wbcc@cap\wbcc@MAX
  \wbcc@i\numexpr\wbcc@overdue+\wbcc@found\relax
  \@whilenum\wbcc@i>\z@\do{%
    \ifnum\csname wbcc@fp@\the\wbcc@i\endcsname=\@ne
      \ifnum\wbcc@i>\wbcc@cap \else \wbcc@cap\numexpr\wbcc@i-\@ne\relax \fi
    \fi
    \advance\wbcc@i\m@ne}%
  \wbcc@m\wbcc@found
  \loop
    \wbcc@nb\numexpr\wbcc@overdue+\wbcc@m\relax
    \wbcc@morefalse
    \ifnum\wbcc@nb>\wbcc@cap                 % over the cap (MAX per page / full-page ahead):
      \ifnum\wbcc@m>\z@                      % shed this page's new markers first ...
        \advance\wbcc@m\m@ne \wbcc@moretrue
      \else                                  % ... then place only up to the cap of the
        \wbcc@nb\wbcc@cap                    % overdue ones; the rest stay overdue
      \fi
    \else
      \ifnum\wbcc@m>\z@
        \wbcc@computebud
        \ifdim\wbcc@bud<\tw@\baselineskip    % not even a line above and below: shed
          \advance\wbcc@m\m@ne \wbcc@moretrue
        \else
          %% Every NEW candidate band must have room for itself BELOW its own position:
          %% Y_j + (band + its skips + rules) <= bud, with Y_j from its marker (P, or
          %% P - bud in the right column) or its explicit Y. (The row below may be empty:
          %% a band may end a page.) This also covers "the marker is past the page"
          %% (P > 2 bud). A band that fails is not pulled up above its text by the Ymax
          %% clamp — it is shed here and lands on the next page, after its text
          %% (reported: a band clamped 87pt above the paragraph it follows). Shedding the
          %% last candidate enlarges bud, so the remaining ones are re-checked.
          \wbcc@fittrue
          \wbcc@j\@ne
          \@whilenum\wbcc@j<\numexpr\wbcc@m+\@ne\relax\do{%
            \edef\wbcc@bi{\the\numexpr\wbcc@overdue+\wbcc@j\relax}%   its pool slot
            %% Y from the marker for every band — also one with an explicit [Y]: its
            %% author asked for THIS page, so a too-low explicit Y is clamped there (with
            %% the warning) rather than sent to the next page.
            \@tempdima\csname wbcc@mh@\the\wbcc@j\endcsname
            \ifdim\@tempdima>\wbcc@bud \advance\@tempdima-\wbcc@bud \fi
            \advance\@tempdima\dimexpr\ht\csname wbcc@b@\wbcc@bi\endcsname
              +\dp\csname wbcc@b@\wbcc@bi\endcsname
              +\csname wbcc@ab@\wbcc@bi\endcsname+\csname wbcc@bl@\wbcc@bi\endcsname
              +\tw@\wbccrulewidth+\tw@\wbccruletick\relax
            \ifdim\@tempdima>\wbcc@bud \wbcc@fitfalse \fi
            \advance\wbcc@j\@ne}%
          \ifwbcc@fit\else \advance\wbcc@m\m@ne \wbcc@moretrue \fi
        \fi
      \fi
    \fi
  \ifwbcc@more\repeat
}

%% After placing \wbcc@nb bands (pool prefix 1..\wbcc@nb), drop them and slide the
%% still-pending tail (\wbcc@nb+1 .. \wbcc@np) down to the front, boxes and Y's
%% together, then shrink the pending total.
\def\wbcc@shiftpool{%
  \wbcc@i\@ne
  \@whilenum\wbcc@i<\numexpr\wbcc@np-\wbcc@nb+\@ne\relax\do{%
    \edef\wbcc@src{\the\numexpr\wbcc@i+\wbcc@nb\relax}%
    \global\setbox\csname wbcc@b@\the\wbcc@i\endcsname\box\csname wbcc@b@\wbcc@src\endcsname
    \global\csname wbcc@Yd@\the\wbcc@i\endcsname\csname wbcc@Yd@\wbcc@src\endcsname
    \global\csname wbcc@ab@\the\wbcc@i\endcsname\csname wbcc@ab@\wbcc@src\endcsname
    \global\csname wbcc@bl@\the\wbcc@i\endcsname\csname wbcc@bl@\wbcc@src\endcsname
    \global\expandafter\let\csname wbcc@rs@\the\wbcc@i\expandafter\endcsname
      \csname wbcc@rs@\wbcc@src\endcsname
    \global\expandafter\let\csname wbcc@fp@\the\wbcc@i\expandafter\endcsname
      \csname wbcc@fp@\wbcc@src\endcsname
    \global\expandafter\let\csname wbcc@id@\the\wbcc@i\expandafter\endcsname
      \csname wbcc@id@\wbcc@src\endcsname
    \global\expandafter\let\csname wbcc@ln@\the\wbcc@i\expandafter\endcsname
      \csname wbcc@ln@\wbcc@src\endcsname
    \advance\wbcc@i\@ne}%
  \global\advance\wbcc@np-\wbcc@nb
}

%% wideband-cc is an OVERLAY on the two-column output routine, not a replacement: the
%% routine in force when the package is loaded (\wbcc@orig@outputdblcol — the kernel's,
%% or the one flushend/stfloats/a class installed) produces every page that carries no
%% band, including the first-column bookkeeping; only a page that places a band is
%% rebuilt here. So load wideband-cc AFTER packages that touch \@outputdblcol; if one
%% redefines it later (\AtBeginDocument), ours is re-installed on top of the new one.
\let\wbcc@orig@outputdblcol\@outputdblcol
\def\wbcc@outputdblcol{%
  \if@firstcolumn
    \wbcc@orig@outputdblcol          % store the left column exactly as the host routine does
  \else
    \global\@firstcolumntrue
    %% Page assignment (marker-driven): scan both finished columns non-destructively.
    %% \wbcc@found = this page's markers; their galley positions land in \wbcc@mh@1..
    %% A band is placed on the page its authored marker falls on — not the page where
    %% \begin{wideband} happened to be read.
    \directlua{wbcc.markpos(\number\@leftcolumn, \number\@outputbox,
      \wbcc@found@n, \wbcc@mh@base, \number\wbcc@MAX)}%   positions: at most MAX registers
    %% An \enlargethispage on this page: a rebuilt page gets the taller height the
    %% operator asked for (local to this output run; undone if the host ships the page).
    \directlua{wbcc.enlargement(\number\@leftcolumn, \number\@outputbox, \wbcc@enl@n)}%
    \advance\@colht\wbcc@enl
    %% The columns' top areas (a host's figures and the room it reserved for them,
    %% top floats) stay at the top of a rebuilt page, side by side as \@makecol set
    %% them; the text and bands are laid out in the height below. Mixed into the text,
    %% NeoPage's wide figure printed over the text of the right column.
    \directlua{wbcc.topheight(\number\@leftcolumn, \number\@outputbox, \wbcc@toph@n)}%
    \advance\@colht-\wbcc@toph
    \wbcc@j\numexpr\wbcc@np-\wbcc@overdue\relax     % pending bands still carrying a marker
    \ifnum\wbcc@found>\wbcc@j
      \PackageWarning{wideband-cc}{markpos found \the\wbcc@found\space markers but
        \the\wbcc@j\space marked bands pending; clamping}%
      \global\wbcc@found\wbcc@j
    \fi
    %% Budget this page's footnotes and bottom floats BEFORE deciding what fits: run the
    %% real extraction on copies of the columns, read the hold boxes, void them again.
    %% Only when a band is pending — an ordinary page is not even copied.
    \@tempdimc\z@ \wbcc@bfh\z@
    \ifnum\wbcc@np>\z@
      \global\setbox\wbcc@fn\box\voidb@x
      \global\setbox\wbcc@bfL\box\voidb@x \global\setbox\wbcc@bfR\box\voidb@x
      \directlua{wbcc.measurebottom(\number\@leftcolumn, \number\@outputbox,
        \number\wbcc@galley, \number\wbcc@fn, \number\wbcc@bfL, \number\wbcc@bfR)}%
      \wbcc@bottomdims
      \global\setbox\wbcc@fn\box\voidb@x
      \global\setbox\wbcc@bfL\box\voidb@x \global\setbox\wbcc@bfR\box\voidb@x
    \fi
    \wbcc@duecount        % -> \wbcc@m fitting new markers; \wbcc@nb = \wbcc@overdue + \wbcc@m
    \ifnum\wbcc@nb>\z@
      %% Markers are NOT stripped here. A placed band's marker sits at the top of the
      %% segment below its band, i.e. inside a row box that ships with this page (a
      %% zero-size whatsit, harmless) — it never reaches the overflow. A deferred-new
      %% marker past the band-page budget lies in the OVERFLOW and rides to the next
      %% page, where it is found again at its true position, so its band lands after its
      %% text; one that turns out to lie inside this page's rows ships with them and its
      %% band becomes overdue below. Leaving all markers in place also lets the attempt
      %% loop shed a band after the fact without losing its marker.
      %% ---- in-run rebuild placing \wbcc@nb bands (overdue + newly-fitting) ----
      %% footnotes: pull each finished column's \@makecol footnote block out and
      %% hold it; one clean block goes at the true page bottom.
      \directlua{wbcc.unwrapcol(\number\@leftcolumn) wbcc.unwrapcol(\number\@outputbox)}%
      \directlua{wbcc.taketop(\number\@leftcolumn, \number\wbcc@tpL)
        wbcc.taketop(\number\@outputbox, \number\wbcc@tpR)}%
      \global\setbox\wbcc@fn\box\voidb@x
      \directlua{wbcc.takefootnotes(\number\@leftcolumn, \number\wbcc@fn)
        wbcc.takefootnotes(\number\@outputbox, \number\wbcc@fn)}%
      %% bottom floats: \@makecol put each column's [b] floats at its bottom; the
      %% reduced budget would carry them into the overflow (they would defer). Pull
      %% them out per column and re-set them at the band page's bottom; shrink the
      %% budget by the taller side + \textfloatsep so text + band + floats + notes fit.
      \global\setbox\wbcc@bfL\box\voidb@x \global\setbox\wbcc@bfR\box\voidb@x
      \directlua{wbcc.takebotfloats(\number\@leftcolumn, \number\wbcc@bfL)
        wbcc.takebotfloats(\number\@outputbox, \number\wbcc@bfR)}%
      \wbcc@bottomdims      % \@tempdimc (notes) and \wbcc@bfh (floats) — the same values
                            % the fit descent already used, now from the real extraction
      %% the bottom block (re-set bottom floats, then the footnotes) boxed first, so
      %% its exact height is known and the page can be measured (\wbcc@makebot)
      \wbcc@makebot
      %% recombine both finished columns (seam-correct join); keep a copy so the
      %% placement can be run again if the measured page overshoots.
      \@tempdima\baselineskip \@tempdimb\lineskip
      \directlua{wbcc.joincols(\number\wbcc@galley, \number\@leftcolumn,
        \number\@outputbox, \number\@tempdima, \number\@tempdimb, \number\lineskiplimit)}%
      \setbox\wbcc@gcopy\copy\wbcc@galley
      \wbcc@snapauto \wbcc@lastcut\z@ \wbcc@tries\z@
      %% \splitmaxdepth\maxdepth bounds each segment's last-line depth (matching the
      %% (N+1)*\maxdepth budget reserve above). \vbadness is silenced (the trailing
      %% \vfil makes every band page technically underfull, and a \flushbottom row
      %% filled to its split height may be underfull too). \vfuzz stays at TeX's
      %% default 0.1pt: every row is exactly its split height or shorter (see
      %% \wbcc@fitseg), the budget is exact sp arithmetic, and the footnote/float
      %% blocks are budgeted with their own slack, so any Overfull \vbox on a band
      %% page is a genuine defect (content past the text area). Tests assert none.
      %% (It used to be 2pt, which silently absorbed the shrink re-expansion that
      %% \wbcc@fitseg now removes.)
      %% \splittopskip\topskip: every segment after the first is the head of a
      %% remainder, so \vsplit gives it \splittopskip glue. With \z@skip its first line
      %% sat flush at its own height (~7pt) while the left column's top row keeps the
      %% page's \topskip (10pt): the right column's first baseline was 3.1pt higher than
      %% the left's on every band page, and rows after a band could misalign by their
      %% first lines' height difference. \topskip puts every segment's first baseline
      %% where a stock column puts it. Budget-neutral: the glue is inside the segment.
      \splittopskip\topskip \splitmaxdepth\maxdepth \vbadness\maxdimen \vfuzz.1\p@
      %% Budget -> Y's -> order -> split -> MEASURE; correct and repeat if the stack would
      %% overshoot (\wbcc@attempt). Order matters inside: \wbcc@autoY keys markers to
      %% pool positions and must run after \wbcc@computebud (its clamp needs \wbcc@bud)
      %% and before \wbcc@sortidx.
      %% Trial splits are silent: an attempt that is then corrected or shed must not log
      %% an Overfull \vbox for a page that never ships. The assembly below re-packs every
      %% row at \vfuzz .1pt, so the page that does ship still reports any overflow.
      \vfuzz\maxdimen
      \wbcc@attempt
      \vfuzz.1\p@
      \wbcc@unresolveshed
      \wbcc@reportclamps
      %% A footnote whose callout went to the overflow goes with it: its note leaves
      %% this page's block and its insert is put back after the callout.
      \directlua{wbcc.fnmove(\number\wbcc@galley, \number\wbcc@fn, \wbcc@fnmoved@n)}%
      \ifnum\wbcc@fnmoved>\z@ \wbcc@makebot \fi
      %% Still printing past the text area after the attempts (a lone overdue band whose
      %% page holds unsplittable material taller than a row, or a page over \@colht):
      %% the operator must make room.
      \wbcc@protrudes
      \ifdim\wbcc@total>\dimexpr\@colht+\vfuzz\relax \wbcc@overtrue \fi
      \ifwbcc@over
        \wbcc@operror{1}{past}{is placed on page \the\c@page, but that page prints past the
          bottom of its text area: material that cannot be split (a figure, table or
          reserved float space) is taller than the room left beside the band}{Move that
          material or the band to another page, then compile again.}%
      \fi
      %% \wbcc@galley now holds the overflow for the next page; count the deferred-new
      %% markers that ride in it (their bands stay pending WITH a marker, not overdue).
      \directlua{wbcc.countmarks(\number\wbcc@galley, \wbcc@ride@n)}%
      %% hyperlinks broken across segments: make each segment self-contained, since the
      %% page ships segments in visual order, not reading order (see wbcc.balancelinks)
      \def\wbcc@segs{}\wbcc@i\@ne
      \@whilenum\wbcc@i<\numexpr\wbcc@nb+\tw@\relax\do{%
        \edef\wbcc@segs{\wbcc@segs\number\csname wbcc@L@\the\wbcc@i\endcsname,}%
        \advance\wbcc@i\@ne}%
      \wbcc@i\@ne
      \@whilenum\wbcc@i<\numexpr\wbcc@nb+\tw@\relax\do{%
        \edef\wbcc@segs{\wbcc@segs\number\csname wbcc@R@\the\wbcc@i\endcsname,}%
        \advance\wbcc@i\@ne}%
      \directlua{wbcc.balancelinks(\wbcc@segs nil)}%
      \setbox\wbcc@top\vbox{\wbcc@assemble}%
      \edef\wbcc@lr{\the\numexpr\wbcc@nb+\@ne\relax}%   the last row's segment index
      %% \flushbottom: the budget's reserve ((N+1)\maxdepth + N\lineskip) is rarely used
      %% in full, and the page used to end in \vfil — ragged by a few points in a flush
      %% document. Measure the leftover now that everything else is boxed and refill
      %% the last row's segments to absorb it, so both columns end at the page bottom.
      \ifx\@textbottom\relax
        \@tempdimb\dimexpr\ht\csname wbcc@L@\wbcc@lr\endcsname
          +\dp\csname wbcc@L@\wbcc@lr\endcsname\relax
        \@tempdimd\dimexpr\ht\csname wbcc@R@\wbcc@lr\endcsname
          +\dp\csname wbcc@R@\wbcc@lr\endcsname\relax
        \ifdim\@tempdimd>\@tempdimb \@tempdimb\@tempdimd \fi   % the last row's natural depth
        \dimen@\dimexpr\@colht-\ht\wbcc@top-\dp\wbcc@top-\@tempdimb
          -\ht\wbcc@bot-\dp\wbcc@bot\relax                      % leftover
        \ifdim\dimen@>\z@
          \advance\@tempdimb\dimen@                               % both segments -> this total
          \expandafter\wbcc@refill\csname wbcc@L@\wbcc@lr\endcsname
          \expandafter\wbcc@refill\csname wbcc@R@\wbcc@lr\endcsname
        \fi
      \fi
      \setbox\@outputbox\vbox to\dimexpr\@colht+\wbcc@toph\relax{%
        \boxmaxdepth\maxdepth
        \ifdim\wbcc@toph>\z@           % the columns' top areas, a row above it all (see
          \hb@xt@\textwidth{%          % \wbcc@toph); in this box, not around it, so its
            \hb@xt@\columnwidth{\vbox to\wbcc@toph{\ifvoid\wbcc@tpL\else\unvbox\wbcc@tpL\fi\vss}\hss}%
            \hfil                      % lines keep the rows' depth (a link that runs on
            \hb@xt@\columnwidth{\vbox to\wbcc@toph{\ifvoid\wbcc@tpR\else\unvbox\wbcc@tpR\fi\vss}\hss}}%
          \nointerlineskip             % to the next page ends at its own level)
        \fi
        \unvbox\wbcc@top
        \nointerlineskip
        \wbcc@row{\wbcc@lr}%
        \vfil                        % \raggedbottom: the leftover stays here
        \nointerlineskip
        \box\wbcc@bot}%
      %% pool bookkeeping: the placed prefix is 1..\wbcc@nb = (\wbcc@nb-\wbcc@m) overdue
      %% bands + \wbcc@m new ones. Still overdue for the next page: the overdue bands
      %% not placed (the per-page cap) plus this page's deferred-new markers that shipped
      %% inside its rows (\wbcc@found-\wbcc@m-\wbcc@ride; the \wbcc@ride riding ones keep
      %% their marker and are not overdue) — together
      %% \wbcc@overdue-\wbcc@nb+\wbcc@found-\wbcc@ride. Galley order = source order, so
      %% the shipped ones precede the riding ones in the pool and the overdue prefix stays
      %% contiguous. Drop the placed prefix and slide the pending tail down to the front.
      \wbcc@logpage{\numexpr\wbcc@found-\wbcc@m-\wbcc@ride\relax}%
      \global\wbcc@overdue\numexpr\wbcc@overdue-\wbcc@nb+\wbcc@found-\wbcc@ride\relax
      \wbcc@shiftpool
      \global\wbcc@nb\z@
      \@combinedblfloats
      \@outputpage
      \global\@colht\textheight
      \wbcc@emitfullpages           % any overdue full-page band at the pool front: its page now
      \unvbox\wbcc@galley           % overflow becomes the next page
      \unskip\unpenalty\unskip      % drop \@makecol's column-bottom glue
      \ifnum\outputpenalty<\@M      % (10000 means "fired at glue, no penalty": re-inserting
        \penalty\outputpenalty      %  THAT would weld the overflow's last line to the text
      \fi                           %  after it — a later \vsplit then cannot break there
                                    %  and takes two lines: measured 14pt overfull)
                                    % re-assert the break that fired us, so the overflow
                                    % ships even when it is the document's last content:
                                    % on a \clearpage-forced flush (\outputpenalty=-\@Mi)
                                    % this re-forces a page for the trailing galley; on a
                                    % natural page break it is inert and later content
                                    % fills the next page as before (plain-TeX idiom).
                                    % ONLY the rebuild branch re-inserts: the stock \else
                                    % branch ships a whole page and must NOT add this, or
                                    % the second (overflow) firing would re-force again and
                                    % emit a blank page. Do not "symmetrise" the two.
      %% double-float pages queued for after this page (stock \@outputdblcol tail; the
      %% delegated branch below lets the host routine do its own)
      \begingroup
        \@dblfloatplacement
        \@startdblcolumn
        \@whilesw\if@fcolmade\fi{\@outputpage\@startdblcolumn}%
      \endgroup
    \else
      %% nothing to place this page (no new marker fit, and either no overdue band or a
      %% full-page band at the front of the pool): the two finished columns ship as a
      %% normal two-column page, so every marker found here ships with it — strip them
      %% and defer their bands to the next page as overdue, behind any already overdue.
      %% A pending band with no marker here is left untouched — it is placed on the page
      %% its marker lands on.
      \directlua{wbcc.stripmarks(\number\@leftcolumn, \number\@outputbox, \number\wbcc@found)}%
      \wbcc@logpage{\wbcc@found}%  (nb = m = 0: every found marker shipped here)
      \global\wbcc@overdue\numexpr\wbcc@overdue+\wbcc@found\relax
      %% no band on this page: let the host routine combine, ship and place double
      %% floats exactly as it always does (flushend's last-page balancing, stfloats, ...).
      %% It expects to be entered in its second-column state.
      \global\@firstcolumnfalse
      \advance\@colht-\wbcc@enl
      \advance\@colht\wbcc@toph
      \ifnum\wbcc@serial>\z@        % (\wbcc@enl is free again here: reused for the amount)
        \directlua{wbcc.overflow(\number\@leftcolumn, \number\@outputbox, \wbcc@enl@n)}%
        \ifdim\wbcc@enl>\wbccoverflowlimit
          \PackageError{wideband-cc}{page \the\c@page\space prints about
            \the\wbcc@enl\space past the bottom of its text area: text or a figure on it
            is cut off}{The bands in this document move text forward, and the page's
            planned figures or tables no longer fit with it. Move a figure or table off
            this page (float placement) or adjust the bands before it, then compile
            again.}%
        \fi
      \fi
      \wbcc@orig@outputdblcol
      \wbcc@emitfullpages           % any overdue full-page band at the pool front: its page now
    \fi
  \fi}
%% Re-overlay whatever routine is in force now (a package may have installed its own).
\def\wbcc@reoverlay{%
  \ifx\@outputdblcol\wbcc@outputdblcol\else
    \let\wbcc@orig@outputdblcol\@outputdblcol
    \let\@outputdblcol\wbcc@outputdblcol
  \fi}
\AtBeginDocument{%
  %% The output overlay is installed here (after every package's own changes to
  %% \@outputdblcol) for the same-page engine; [elsevier] leaves the host routine alone.
  \ifwbcc@elsevieradapter
    \PackageInfo{wideband-cc}{Elsevier NeoPage adapter selected; active bands use
      a source-order-safe next-page full-width top}%
  \else
    \wbcc@reoverlay
    %% tag each footnote with its callout, so a rebuilt page can send a note whose
    %% callout went to the next page after it (see wbcc.fnmove)
    \directlua{wbcc.fninit(\number\footins)}%
    %% flushend swaps in its last-page balancing routine at \@kernel@after@enddocument
    %% (registered from ITS \AtBeginDocument, which ran before this one); append the
    %% re-overlay after it so the last page is balanced by flushend when it has no band
    %% and rebuilt here when it has one.
    \ifdefined\@kernel@after@enddocument
      \g@addto@macro\@kernel@after@enddocument{\wbcc@reoverlay}%
    \fi
  \fi}

\endinput
